        self.lbl_s_val.setFixedWidth(30)
        sliders_lay.addWidget(self.lbl_s_val, 1, 2)
        
        # Value (Brightness)
        sliders_lay.addWidget(QLabel("Brillo:"), 2, 0)
        self.sld_v = QSlider(Qt.Orientation.Horizontal)
