        local_lay.addWidget(inst_hdr)

        self.btn_install_ollama = QPushButton("DESCARGAR INSTALADOR PARA WINDOWS")
        self.btn_install_ollama.setMinimumSize(0, 32)
        self.btn_install_ollama.setStyleSheet(f"""
            QPushButton {{
                background-color: rgba(255, 255, 255, 0.1);
                color: {C_PRI};
