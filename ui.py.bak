        local_lay.addLayout(status_box)

        # Divider
        sep1 = QFrame()
        sep1.setFrameShape(QFrame.Shape.HLine)
        sep1.setFrameShadow(QFrame.Shadow.Sunken)
        local_lay.addWidget(sep1)

        # Installer section
        inst_hdr = QLabel("NUEVO USUARIO: INSTALAR OLLAMA")
