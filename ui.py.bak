        tab_local_main_lay.addWidget(scroll_local)
        
        scroll_local_widget = QWidget()
        scroll_local_widget.setStyleSheet("background: transparent;")
        local_lay = QVBoxLayout(scroll_local_widget)
        local_lay.setSpacing(10)
        local_lay.setContentsMargins(15, 15, 15, 15)
        scroll_local.setWidget(scroll_local_widget)

        # Connection status section (Holographic style)
        status_box = QHBoxLayout()
        self.lbl_ollama_status = QLabel("ESTADO: SIN VERIFICAR")
        self.lbl_ollama_status.setMinimumWidth(10)
        self.lbl_ollama_status.setStyleSheet("color: #a1a1aa; font-weight: bold; font-size: 11px; letter-spacing: 1.5px;")
        status_box.addWidget(self.lbl_ollama_status)
        status_box.addStretch()

        self.btn_check_ollama = QPushButton("VERIFICAR ESTADO")
        self.btn_check_ollama.setMinimumSize(140, 28)
        self.btn_check_ollama.setStyleSheet(f"""
