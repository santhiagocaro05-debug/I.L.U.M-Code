        self.global_progress_bar.setFixedWidth(200)
        self.global_progress_bar.setTextVisible(True)
        self.global_progress_bar.setStyleSheet(f"QProgressBar {{ border: 1px solid {C_BORDER}; border-radius: 4px; text-align: center; color: white; font-size: 9px; background-color: rgba(0,0,0,0.5); }} QProgressBar::chunk {{ background-color: {C_PRI}; width: 5px; }}")
        status_bar_layout.addWidget(self.global_progress_bar)
        
        self.bg_layout.addLayout(status_bar_layout)
        
        self.update_style()
        
    def update_style(self):
        style = f"""
        #StudentBg {{
            background-color: {C_BG};
            border: 2px solid {C_BORDER};
            border-radius: 20px;
        }}
        QLabel {{ color: {C_TEXT}; font-family: 'Segoe UI'; }}
        QPushButton {{
            background-color: {C_PRI_DIM};
            color: {C_TEXT};
            border: 1px solid {C_BORDER};
            border-radius: 20px;
            padding: 10px;
            font-weight: bold;
            font-family: 'Segoe UI';
        }}
        QPushButton:hover {{
            background-color: {C_PRI};
            color: #0f0a02;
        }}
        QPushButton:disabled {{
            background-color: rgba(128, 128, 128, 0.1);
            color: rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(128, 128, 128, 0.2);
        }}
        QTextEdit, QTextBrowser {{
            background-color: rgba(0, 0, 0, 0.6);
            color: #ffffff;
            border: 1px solid {C_BORDER};
            border-radius: 20px;
            font-family: 'Consolas', 'Segoe UI';
            font-size: 13px;
        }}
        QTabWidget::pane {{
            border: 1px solid {C_BORDER};
            border-radius: 20px;
            background-color: rgba(22, 16, 5, 0.4);
        }}
        QTabBar::tab {{
            background: rgba(35, 28, 10, 0.6);
            color: {C_TEXT};
            padding: 12px 20px;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
            border: 1px solid {C_BORDER};
            border-bottom: none;
            margin-right: 4px;
        }}
        QTabBar::tab:selected {{
            background: {C_PRI_DIM};
            border-bottom: 2px solid {C_PRI};
            font-weight: bold;
        }}
        QTabBar::tab:hover {{
            background: rgba(245, 158, 11, 0.2);
        }}
        QScrollArea {{
            background-color: rgba(0, 0, 0, 0.5);
            border: 1px solid {C_BORDER};
            border-radius: 20px;
        }}
        QScrollBar:vertical {{
            border: none;
            background: rgba(0, 0, 0, 0.3);
            width: 10px;
            margin: 0px;
        }}
        QScrollBar::handle:vertical {{
            background: {C_PRI_DIM};
            min-height: 20px;
            border-radius: 20px;
        }}
        QScrollBar::handle:vertical:hover {{
            background: {C_PRI};
        }}
        """
        self.setStyleSheet(style)
        apply_glass_shadow(self)

    def select_pdf_manually(self):
        from PyQt6.QtWidgets import QFileDialog
        pdf_path, _ = QFileDialog.getOpenFileName(self, "Seleccionar PDF para Convertir", "", "Documentos PDF (*.pdf)")
        if not pdf_path:
            return
            
        from pathlib import Path
        pdf_path_obj = Path(pdf_path)
        docx_path = str(pdf_path_obj.with_suffix(".docx"))
        
        self.pdf_file_label.setText(f"Archivo: {pdf_path}")
        self.btn_pdf_convert.setEnabled(False)
        self.pdf_progress.setValue(0)
        self.pdf_status_label.setText("Estado: Iniciando conversión...")
        self.global_progress_bar.setValue(0)
        self.global_status_label.setText("Estado: Iniciando conversión PDF a Word...")
        
        self.pdf_worker = PdfToWordWorker(pdf_path, docx_path)
        self.pdf_worker.progress.connect(self.pdf_progress.setValue)
        self.pdf_worker.status.connect(self.pdf_status_label.setText)
        self.pdf_worker.progress.connect(self.global_progress_bar.setValue)
        self.pdf_worker.status.connect(lambda s: self.global_status_label.setText(f"PDF a Word: {s}"))
        self.pdf_worker.finished.connect(self.pdf_conversion_finished)
        self.pdf_worker.start()
        
    def pdf_conversion_finished(self, msg):
        self.btn_pdf_convert.setEnabled(True)
        self.pdf_status_label.setText("Estado: Completado.")
        if "Error" in msg or "fallido" in msg:
            self.global_status_label.setText("Error en la conversión de PDF.")
            self.global_progress_bar.setValue(0)
            QMessageBox.critical(self, "Error", msg)
        else:
            self.global_status_label.setText("Estado: Conversión completada con éxito.")
            self.global_progress_bar.setValue(100)
            QMessageBox.information(self, "Éxito", msg)
            
    def trigger_paraphrase_manually(self):
        text = self.ghost_input.toPlainText().strip()
        if not text:
            return
            
        self.ghost_output.setPlainText("Artemisa está procesando y parafraseando tu texto...")
        self.btn_ghost_run.setEnabled(False)
        self.global_status_label.setText("Estado: Parafraseando texto académico...")
        self.global_progress_bar.setValue(35)
        
        def run_api():
            try:
                from memory.config_manager import load_api_keys
                import zipfile
                from pathlib import Path
                
                cfg = load_api_keys()
                
                ghost_prompt = ""
                skill_path = Path("ghost.skill")
                if skill_path.exists():
                    try:
                        with zipfile.ZipFile(skill_path, 'r') as zf:
                            for name in zf.namelist():
                                if name.endswith("SKILL.md"):
                                    ghost_prompt = zf.read(name).decode("utf-8")
                                    break
                    except Exception as e:
                        print(f"Error reading ghost.skill: {e}")
                
                if not ghost_prompt:
                    ghost_prompt = (
                        "Actúa como un reescritor y parafraseador de nivel académico extremadamente sofisticado.\n"
                        "Reescribe el siguiente texto evadiendo detectores de IA."
                    )
                
                from google import genai
                client = genai.Client(api_key=cfg.get("gemini_api_key", ""))
                resp = client.models.generate_content(
                    model="gemini-2.5-flash",
                    contents=f"{ghost_prompt}\n\nTEXTO A PROCESAR:\n{text}"
                )
                return resp.text.strip()
            except Exception as e:
                return f"Error: {e}"
                
        class ParaphraseApiWorker(QThread):
            res = pyqtSignal(str)
            def run(self):
                self.res.emit(run_api())
                
        self.para_worker = ParaphraseApiWorker()
        self.para_worker.res.connect(self.paraphrase_finished)
        self.para_worker.start()
        
    def paraphrase_finished(self, result):
        self.ghost_output.setPlainText(result)
        self.btn_ghost_run.setEnabled(True)
        if result.startswith("Error"):
            self.global_status_label.setText("Error en el parafraseo.")
            self.global_progress_bar.setValue(0)
        else:
            self.global_status_label.setText("Estado: Parafraseo completado con éxito.")
            self.global_progress_bar.setValue(100)
            
    def load_apa_file_manually(self):
        from PyQt6.QtWidgets import QFileDialog
        file_path, _ = QFileDialog.getOpenFileName(self, "Cargar Documento para Validación APA 7", "", "Documentos (*.pdf *.docx)")
        if not file_path:
            return
            
        self.loaded_apa_file = file_path
        self.global_status_label.setText("Estado: Cargando y renderizando páginas...")
        self.global_progress_bar.setValue(10)
        self.btn_apa_load.setEnabled(False)
        self.btn_apa_run.setEnabled(False)
        
        self.render_worker = DocumentRenderWorker(file_path)
        self.render_worker.status.connect(self.global_status_label.setText)
        self.render_worker.progress.connect(self.global_progress_bar.setValue)
        self.render_worker.finished.connect(self.apa_file_rendered)
        self.render_worker.start()
        
    def apa_file_rendered(self, pages, error):
        self.btn_apa_load.setEnabled(True)
        self.btn_apa_run.setEnabled(True)
        
        if error:
            self.global_status_label.setText(f"Error: {error}")
            self.global_progress_bar.setValue(0)
            QMessageBox.critical(self, "Error al cargar documento", error)
            return
            
        while self.apa_viewer_layout.count():
            item = self.apa_viewer_layout.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()
                
        from PyQt6.QtGui import QPixmap
        for idx, qimg in enumerate(pages):
            page_lbl = QLabel()
            page_lbl.setPixmap(QPixmap.fromImage(qimg))
            page_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            page_lbl.setStyleSheet("border: 1px solid rgba(245, 158, 11, 0.45); border-radius: 6px; background-color: white; margin: 15px; padding: 2px;")
            
            shadow = QGraphicsDropShadowEffect()
            shadow.setBlurRadius(15)
            shadow.setColor(QColor(0, 0, 0, 180))
            shadow.setOffset(3, 3)
            page_lbl.setGraphicsEffect(shadow)
            
            self.apa_viewer_layout.addWidget(page_lbl)
            
        self.global_status_label.setText("Estado: Documento cargado y visualizador de alta fidelidad listo.")
        self.global_progress_bar.setValue(100)
        
    def clear_apa_file(self):
        self.loaded_apa_file = ""
        self.apa_output.setPlainText("")
        
        while self.apa_viewer_layout.count():
            item = self.apa_viewer_layout.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()
                
        self.apa_placeholder = QLabel("Sube un PDF/DOCX para ver la previsualización del documento aquí.\nLa evaluación APA será 100% visual en base a esta vista.")
        self.apa_placeholder.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.apa_placeholder.setStyleSheet("color: rgba(255, 255, 255, 0.5);")
        self.apa_viewer_layout.addWidget(self.apa_placeholder)
                
        self.global_status_label.setText("Estado: Visualizador de páginas limpiado.")
        self.global_progress_bar.setValue(0)
        
    def trigger_apa_manually(self):
        if not self.loaded_apa_file:
            QMessageBox.warning(self, "Aviso", "Por favor, carga un documento PDF o DOCX primero para la revisión visual.")
            return
            
        self.apa_output.setPlainText("Artemisa Multimodal está evaluando visualmente la estructura de citas, márgenes e interlineado de tu documento...")
        self.btn_apa_run.setEnabled(False)
        self.global_status_label.setText("Estado: Iniciando verificación APA 7 Multimodal...")
        self.global_progress_bar.setValue(15)
        
        self.apa_verify_worker = ApaVerifyWorker("", self.loaded_apa_file)
        self.apa_verify_worker.status.connect(self.global_status_label.setText)
        self.apa_verify_worker.progress.connect(self.global_progress_bar.setValue)
        self.apa_verify_worker.finished.connect(self.apa_verification_finished)
        self.apa_verify_worker.start()
        
    def apa_verification_finished(self, report):
        self.apa_output.setPlainText(report)
        self.btn_apa_run.setEnabled(True)
        if report.startswith("Error"):
            self.global_status_label.setText("Error en la verificación APA 7.")
            self.global_progress_bar.setValue(0)
            if hasattr(self, 'btn_apa_download'): self.btn_apa_download.setEnabled(False)
        else:
            self.global_status_label.setText("Estado: Informe de verificación APA 7 generado con éxito.")
            self.global_progress_bar.setValue(100)
            if hasattr(self, 'btn_apa_download'): self.btn_apa_download.setEnabled(True)
            
    def load_quality_file_manually(self):
        from PyQt6.QtWidgets import QFileDialog
        file_path, _ = QFileDialog.getOpenFileName(self, "Cargar Documento para Análisis de Rigor", "", "Documentos (*.txt *.pdf *.docx);;Todos los archivos (*)")
        if not file_path:
            return
            
        from actions.student_mode import extract_text
        from pathlib import Path
        text = extract_text(file_path)
        if not text or text.startswith("[Error"):
            QMessageBox.critical(self, "Error", "No se pudo extraer texto legible del documento seleccionado.")
            return
            
        self.loaded_quality_text = text
        self.loaded_quality_file = file_path
        self.quality_file_label.setText(f"Archivo: {file_path}")
        self.btn_q_run.setEnabled(True)
        self.global_status_label.setText("Estado: Documento cargado para evaluación de rigor.")
        
    def run_quality_report_manually(self):
        if not self.loaded_quality_text:
            return
            
        self.btn_q_run.setEnabled(False)
        self.global_status_label.setText("Estado: Generando reporte de rigor científico...")
        self.global_progress_bar.setValue(25)
        
        from pathlib import Path
        self.quality_worker = QualityReportWorker(self.loaded_quality_text, Path(self.loaded_quality_file).name)
        self.quality_worker.status.connect(lambda s: self.global_status_label.setText(f"Calidad: {s}"))
        self.quality_worker.finished.connect(self.quality_report_finished)
        self.quality_worker.start()
        
    def quality_report_finished(self, report_html):
        self.btn_q_run.setEnabled(True)
        self.quality_output.setHtml(report_html)
        if "Error" in report_html:
            self.global_status_label.setText("Error en la evaluación de calidad.")
            self.global_progress_bar.setValue(0)
            if hasattr(self, 'btn_q_download'): self.btn_q_download.setEnabled(False)
        else:
            self.global_status_label.setText("Estado: Reporte de calidad y rigor completado.")
            self.global_progress_bar.setValue(100)
            if hasattr(self, 'btn_q_download'): self.btn_q_download.setEnabled(True)

    def download_apa_report(self):
        try:
            from memory.config_manager import BASE_DIR
            out_dir = os.path.join(BASE_DIR, "Descargas_Ilum")
            os.makedirs(out_dir, exist_ok=True)
            import time
            fname = f"Reporte_APA_{int(time.time())}.txt"
            fpath = os.path.join(out_dir, fname)
            with open(fpath, "w", encoding="utf-8") as f:
                f.write(self.apa_output.toPlainText())
            QMessageBox.information(self, "Descarga Completada", f"Reporte de Normas APA guardado en:\n{out_dir}")
            os.startfile(out_dir)
        except Exception as e:
            QMessageBox.critical(self, "Error", f"No se pudo guardar el archivo:\n{e}")

    def download_quality_report(self):
        try:
            from memory.config_manager import BASE_DIR
            out_dir = os.path.join(BASE_DIR, "Descargas_Ilum")
            os.makedirs(out_dir, exist_ok=True)
            import time
            fname = f"Reporte_Calidad_{int(time.time())}.html"
            fpath = os.path.join(out_dir, fname)
            with open(fpath, "w", encoding="utf-8") as f:
                f.write(self.quality_output.toHtml())
            QMessageBox.information(self, "Descarga Completada", f"Reporte de Calidad Académica guardado en:\n{out_dir}")
            os.startfile(out_dir)
        except Exception as e:
            QMessageBox.critical(self, "Error", f"No se pudo guardar el archivo:\n{e}")