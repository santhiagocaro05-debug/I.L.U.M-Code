                color: white;
                border-color: #ff3b30;
            }}
        """)
        header.addWidget(self.btn_close)
        layout.addLayout(header)
        
        # Search & Filter bar
        filter_layout = QHBoxLayout()
        filter_layout.setSpacing(8)
        
        self.inp_filter = QLineEdit()
        self.inp_filter.setPlaceholderText("Filtrar logs (ej: ERR, SYS, Spotify)...")
        self.inp_filter.textChanged.connect(self.filter_logs)
        self.inp_filter.setStyleSheet(f"""
            QLineEdit {{
                background-color: rgba(0, 0, 0, 0.4);
                color: white;
                border: 1px solid rgba(245, 158, 11, 0.4);
                border-radius: 6px;
                padding: 6px 10px;
                font-size: 11px;
            }}
            QLineEdit:focus {{
                border-color: {C_PRI};
            }}
        """)
        filter_layout.addWidget(self.inp_filter)
        
        self.btn_refresh = QPushButton("ACTUALIZAR")
        self.btn_refresh.setFixedSize(110, 28)
        self.btn_refresh.clicked.connect(self.load_logs)
        self.btn_refresh.setStyleSheet(f"""
            QPushButton {{
                background-color: rgba(10, 22, 32, 0.7);
                color: {C_PRI};
                border: 1.5px solid {C_PRI};
                font-weight: bold;
                border-radius: 6px;
                font-size: 10px;
                letter-spacing: 1px;
            }}
            QPushButton:hover {{
                background-color: {C_PRI};
                color: {C_BG};
            }}
        """)
        filter_layout.addWidget(self.btn_refresh)
        layout.addLayout(filter_layout)
        
        # Logs display area
        self.txt_logs = QTextEdit()
        self.txt_logs.setReadOnly(True)
        self.txt_logs.setFont(QFont("Consolas", 10))
        self.txt_logs.setStyleSheet(f"""
            QTextEdit {{
                background-color: rgba(5, 7, 10, 0.9);
                color: #e2e8f0;
                border: 1.2px solid rgba(245, 158, 11, 0.35);
                border-radius: 8px;
                padding: 8px;
            }}
        """)
        layout.addWidget(self.txt_logs)
        
        # Apply dialog-wide premium styling
        self.setStyleSheet(f"""
            QWidget#logsContainer {{
                background-color: {C_BG};
                border: 2px solid {C_PRI};
                border-radius: 12px;
            }}
        """)
        
        # Load initial logs
        self.raw_log_lines = []
        self.load_logs()
        
        # Setup auto-refresh for logs
        self.refresh_timer = QTimer(self)
        self.refresh_timer.timeout.connect(self.load_logs)
        self.refresh_timer.start(2000)  # Refresh every 2 seconds

    def load_logs(self):
        try:
            from memory.config_manager import BASE_DIR
            log_file = BASE_DIR / "ilum.log"
            if not log_file.exists():
                from pathlib import Path
                log_file = Path("ilum.log")
            
            if log_file.exists():
                with open(log_file, "r", encoding="utf-8", errors="ignore") as f:
                    self.raw_log_lines = f.readlines()
            else:
                self.raw_log_lines = ["No se encontró el archivo de log 'ilum.log'."]
        except Exception as e:
            self.raw_log_lines = [f"Error al leer logs: {e}"]
        
        self.filter_logs()

    def filter_logs(self):
        filter_text = self.inp_filter.text().lower().strip()
        lines_to_show = self.raw_log_lines[-400:] # last 400 lines
        
        formatted_html = ""
        for line in lines_to_show:
            if filter_text and filter_text not in line.lower():
                continue
                
            # Clean and escape HTML entities slightly for safety
            escaped = line.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            
            # Formatting line colors based on level/prefix
            if "err" in line.lower() or "exception" in line.lower() or "error" in line.lower() or "fail" in line.lower():
                color = "#ff4d4d" # Bright red for errors
                font_weight = "bold"
            elif "sys:" in line.lower():
                color = C_PRI # Golden/cyan for system notices
                font_weight = "bold"
            elif "ilum:" in line.lower():
                color = "#00ff88" # Green for Ilum' responses
                font_weight = "normal"
            elif "tú:" in line.lower() or "tu:" in line.lower():
                color = "#00d4ff" # Light blue for user input
                font_weight = "normal"
            else:
                color = "#cbd5e1" # standard text color
                font_weight = "normal"
                
            formatted_html += f"<span style='color: {color}; font-weight: {font_weight};'>{escaped}</span><br>"
            
        self.txt_logs.setHtml(formatted_html)
        
        # Process events and scroll to bottom automatically
        from PyQt6.QtCore import QTimer
        QTimer.singleShot(50, lambda: self.txt_logs.verticalScrollBar().setValue(self.txt_logs.verticalScrollBar().maximum()))

    # Mouse drag window methods
    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.drag_position = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
       
