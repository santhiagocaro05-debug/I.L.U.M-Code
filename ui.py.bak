def get_bundled_path(*paths):
    if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS"):
        return Path(sys._MEIPASS).joinpath(*paths)
    return Path(__file__).resolve().parent.joinpath(*paths)

