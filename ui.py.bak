    def _toggle_ollama_fields(self):
        is_ollama = (self.cmb_ai_provider.currentData() == "ollama")
        self.btn_advanced_net.setVisible(is_ollama)
        self.net_advanced_widget.setVisible(is_ollama and self.btn_advanced_net.isChecked())
        self.ollama_model_lbl.setVisible(is_ollama)
        self.cmb_ollama_model.setVisible(is_ollama)
        if is_ollama:
            self.refresh_ollama_model_list()

    def refresh_ollama_model_list(self):
        if not hasattr(self, "_is_checking_ollama") or not self._is_checking_ollama:
            self.check_ollama_status()
 
    def _toggle_fish_audio_fields(self):
        enabled = self.chk_fish_audio.isChecked()
        self.lbl_fish_api_key.setVisible(enabled)
        self.inp_fish_api_key.setVisible(enabled)
        self.lbl_fish_voice_id.setVisible(enabled)
        self.inp_fish_voice_id.setVisible(enabled)
        if enabled:
            self.chk_local_tts.setChecked(False)

    def _toggle_local_tts_fields(self):
        if self.chk_local_tts.isChecked():
            self.chk_fish_audio.setChecked(False)

    def _toggle_theme_fields(self):
        if not hasattr(self, "btn_color_picker") or not hasattr(self, "lbl_color_preview"):
            return
        is_custom = (self.cmb_theme.currentData() == "custom")
        self.btn_color_picker.setVisible(is_custom)
        self.lbl_color_preview.setVisible(is_custom)
 
    def _open_color_picker(self):
        initial = QColor(self.custom_color_hex) if self.custom_color_hex else QColor(C_PRI)
        dialog = IlumColorPicker(self, initial)
        if dialog.exec() == QDialog.DialogCode.Accepted:
            self.custom_color_hex = dialog.selected_color.name()
            self.lbl_color_preview.setStyleSheet(f"background-color: {self.custom_color_hex}; border: 1.5px solid white; border-radius: 6px;")

    def _select_override_color(self, target):
        from PyQt6.QtWidgets import QColorDialog
        initial = QColor(C_PRI)
        if target == "bg":
            initial = QColor(C_BG)
        elif target == "panel":
            initial = QColor(C_PANEL)
        elif target == "text":
            initial = QColor(C_TEXT)
            
        color = QColorDialog.getColor(initial, self, f"Seleccionar Color de {target.upper()}")
        if color.isValid():
            hex_color = color.name()
            if target == "bg":
                self._custom_bg_color = hex_color
            elif target == "panel":
                self._custom_panel_color = f"rgba({color.red()}, {color.green()}, {color.blue()}, 0.70)"
            elif target == "text":
                self._custom_text_color = hex_color
            IlumMessageBox(self, "SUCCESS", f"COLOR DE {target.upper()} CONFIGURADO.").exec()

    def _reset_override_colors(self):
        self._custom_bg_color = ""
        self._custom_panel_color = ""
        self._custom_text_color = ""
        QMessageBox.information(self, "SUCCESS", "COLORES INDIVIDUALES REINICIADOS.")

    def _generate_role_prompt(self):
        kw = self.inp_prompt_generator.text().strip()
        if not kw:
            QMessageBox.warning(self, "Error", "Ingresa al menos una palabra clave para generar el rol.")
            return
        prompt = (f"Adopta de manera estricta y absoluta la siguiente personalidad y rol: {kw}.\\n"
                  "Tu comportamiento, tono de voz, nivel técnico y manera de expresarte deben estar completamente "
                  "alineados con esta descripción en cada interacción. Nunca rompas el personaje bajo ninguna circunstancia.")
        self.txt_personality_prompt.setPlainText(prompt)

    def _select_bg_image(self):
        from PyQt6.QtWidgets import QFileDialog
        file_path, _ = QFileDialog.getOpenFileName(self, "Seleccionar Imagen de Fondo", "", "Imágenes (*.png *.jpg *.jpeg *.bmp)")
        if file_path:
            self._custom_bg_image = file_path
            IlumMessageBox(self, "SUCCESS", "FOTO DE FONDO SELECCIONADA.").exec()

    def _remove_bg_image(self):
        self._custom_bg_image = ""
        IlumMessageBox(self, "SUCCESS", "FOTO DE FONDO ELIMINADA.").exec()

    def _select_sticker(self):
        from PyQt6.QtWidgets import QFileDialog
        file_path, _ = QFileDialog.getOpenFileName(self, "Seleccionar Sticker", "", "Imágenes (*.png *.jpg *.jpeg *.gif)")
        if file_path:
            self._custom_sticker_path = file_path
            IlumMessageBox(self, "SUCCESS", "STICKER SELECCIONADO.").exec()
            self._update_sticker_preview()

    def _remove_sticker(self):
        self._custom_sticker_path = ""
        IlumMessageBox(self, "SUCCESS", "STICKER ELIMINADO.").exec()
        self._update_sticker_preview()

    def _update_sticker_preview(self):
        w = self.sld_sticker_w.value()
        h = self.sld_sticker_h.value()
        x_pct = self.sld_sticker_x.value()
        y_pct = self.sld_sticker_y.value()
        
        self.lbl_st_w.setText(f"{w} PX")
        self.lbl_st_h.setText(f"{h} PX")
        self.lbl_st_x.setText(f"{x_pct}%")
        self.lbl_st_y.setText(f"{y_pct}%")
        
        # Scale to mini preview frame (120x90) relative to standard HUD dimensions (1000x750)
        mini_w = max(4, int(w / 1000.0 * 120.0))
        mini_h = max(4, int(h / 750.0 * 90.0))
        self.mini_sticker_indicator.setFixedSize(mini_w, mini_h)
        
        # Position relative
        x_pos = int((120 - mini_w) * (x_pct / 100.0))
        y_pos = int((90 - mini_h) * (y_pct / 100.0))
        self.mini_sticker_indicator.move(x_pos, y_pos)
 
    def _toggle_advanced_spotify(self, checked):
        self.spotify_id_lbl.setVisible(checked)
        self.inp_spotify_id.setVisible(checked)
        self.spotify_secret_lbl.setVisible(checked)
        self.inp_spotify_secret.setVisible(checked)
        self.spotify_uri_lbl.setVisible(checked)
        self.inp_spotify_uri.setVisible(checked)

    # ── Personality Management Methods ──────────────────────────────────────
    def _on_personality_changed(self):
        key = self.cmb_personality.currentData()
        if key and hasattr(self, "_personalities_dict") and key in self._personalities_dict:
            self.txt_personality_prompt.blockSignals(True)
            self.txt_personality_prompt.setPlainText(self._personalities_dict[key]["prompt"])
            self.txt_personality_prompt.blockSignals(False)

    def _on_personality_prompt_edited(self):
        key = self.cmb_personality.currentData()
        if key and hasattr(self, "_personalities_dict") and key in self._personalities_dict:
            self._personalities_dict[key]["prompt"] = self.txt_personality_prompt.toPlainText()

    def _rename_active_personality(self):
        key = self.cmb_personality.currentData()
        if not key or not hasattr(self, "_personalities_dict") or key not in self._personalities_dict:
            return
            
        from PyQt6.QtWidgets import QInputDialog, QLineEdit
        old_name = self._personalities_dict[key]["name"]
        new_name, ok = QInputDialog.getText(self, "Renombrar Personalidad",
                                          f"Nuevo nombre para '{old_name}':",
                                          QLineEdit.EchoMode.Normal, old_name)
        
        if ok and new_name.strip() and new_name.strip() != old_name:
            self._personalities_dict[key]["name"] = new_name.strip()
            idx = self.cmb_personality.findData(key)
            if idx >= 0:
                self.cmb_personality.setItemText(idx, new_name.strip())

    def _create_new_personality(self):
        from PyQt6.QtWidgets import QInputDialog, QLineEdit
        name, ok = QInputDialog.getText(self, "Crear Nueva Personalidad",
                                       "Nombre de la nueva personalidad:",
                                       QLineEdit.EchoMode.Normal, "")
        if not ok or not name.strip():
            return
            
        import re
        key = re.sub(r'[^a-z0-9_]', '_', name.strip().lower())
        if not hasattr(self, "_personalities_dict"):
            self._personalities_dict = {}
            
        if key in self._personalities_dict:
            IlumMessageBox(self, "Error", f"Ya existe una personalidad con la clave '{key}'.").exec()
            return
            
        self._personalities_dict[key] = {
            "name": name.strip(),
            "prompt": "Describe aqui el comportamiento, tono y estilo de esta personalidad..."
        }
        self.cmb_personality.blockSignals(True)
        self.cmb_personality.addItem(name.strip(), key)
        self.cmb_personality.setCurrentIndex(self.cmb_personality.count() - 1)
        self.cmb_personality.blockSignals(False)
        self._on_personality_changed()
        IlumMessageBox(self, "SUCCESS", f"Personalidad '{name.strip()}' creada con exito.").exec()

    def _delete_personality(self):
        key = self.cmb_personality.currentData()
        if not key or not hasattr(self, "_personalities_dict") or key not in self._personalities_dict:
            return
        if key == "actual":
            IlumMessageBox(self, "Error", "No se puede eliminar la personalidad original de ILUM.").exec()
            return
        if self.cmb_personality.count() <= 1:
            IlumMessageBox(self, "Error", "Debe quedar al menos una personalidad.").exec()
            return
            
        name = self._personalities_dict[key]["name"]
        del self._personalities_dict[key]
        
        self.cmb_personality.blockSignals(True)
        idx = self.cmb_personality.currentIndex()
        self.cmb_personality.removeItem(idx)
        self.cmb_personality.setCurrentIndex(0)
        self.cmb_personality.blockSignals(False)
        
        self._on_personality_changed()
        IlumMessageBox(self, "SUCCESS", f"Personalidad '{name}' eliminada con exito.").exec()

    def _save_personalities_file(self):
        try:
            from memory.config_manager import BASE_DIR
            import json
            pers_path = BASE_DIR / "config" / "personalities.json"
            active_key = self.cmb_personality.currentData()
            pers_data = {
                "active": active_key,
                "personalities": self._personalities_dict
            }
            pers_path.write_text(json.dumps(pers_data, indent=2, ensure_ascii=False), encoding="utf-8")
        except Exception as e:
            print(f"Error saving active personality configurations: {e}")

    def load_macros(self):
        self.lst_macros.clear()
        try:
            from memory.config_manager import BASE_DIR
            macros_path = BASE_DIR / "config" / "macros.json"
            if macros_path.exists():
                with open(macros_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    for name in data.keys():
                        self.lst_macros.addItem(name)
        except Exception as e:
            print("Error loading macros:", e)

    def _open_macro_recorder(self):
        from PyQt6.QtWidgets import QInputDialog, QMessageBox
        name, ok = QInputDialog.getText(self, "Grabar Macro", "Nombre del nuevo macro:")
        if ok and name.strip():
            name = name.strip()
            self.btn_record_macro.setText("Grabando... (Presiona ESC para detener)")
            self.btn_record_macro.setEnabled(False)
            QApplication.processEvents()
            
            import threading
            def record_thread():
                try:
                    from actions.macro_recorder import record_macro_until_esc
                    record_macro_until_esc(name)
                    # Use QMetaObject to safely call a method in the main thread
                    from PyQt6.QtCore import QMetaObject, Qt, Q_ARG
                    QMetaObject.invokeMethod(self, "_on_macro_record_finished", Qt.ConnectionType.QueuedConnection, Q_ARG(str, name), Q_ARG(str, "success"))
                except Exception as e:
                    from PyQt6.QtCore import QMetaObject, Qt, Q_ARG
                    QMetaObject.invokeMethod(self, "_on_macro_record_finished", Qt.ConnectionType.QueuedConnection, Q_ARG(str, name), Q_ARG(str, str(e)))

            threading.Thread(target=record_thread, daemon=True).start()

    @pyqtSlot(str, str)
    def _on_macro_record_finished(self, name: str, result: str):
        from PyQt6.QtWidgets import QMessageBox
        self.btn_record_macro.setText("Grabar Nuevo Macro")
        self.btn_record_macro.setEnabled(True)
        if result == "success":
            QMessageBox.information(self, "Éxito", f"Macro '{name}' grabado con éxito.")
            self.load_macros()
        else:
            QMessageBox.critical(self, "Error", f"Error grabando macro: {result}")

    def _delete_selected_macro(self):
        item = self.lst_macros.currentItem()
        if not item: return
        name = item.text()
        try:
            from memory.config_manager import BASE_DIR
            macros_path = BASE_DIR / "config" / "macros.json"
            if macros_path.exists():
                with open(macros_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if name in data:
                    del data[name]
                    with open(macros_path, "w", encoding="utf-8") as f:
                        json.dump(data, f, indent=4)
            self.load_macros()
        except Exception:
            pass

    def _run_selected_macro(self):
        item = self.lst_macros.currentItem()
        if not item: return
        name = item.text()
        try:
            from actions.macro_recorder import play_macro
            # Ejecutar de forma no bloqueante usando threading para no colgar la UI
            import threading
            threading.Thread(target=play_macro, args=(name,), daemon=True).start()
        except Exception:
            pass

    def _browse_app_icon(self):
        from PyQt6.QtWidgets import QFileDialog
        import os
        from memory.config_manager import BASE_DIR
        initial_dir = str(BASE_DIR / "assets" / "iconos")
        if not os.path.exists(initial_dir):
            initial_dir = str(BASE_DIR)
        path, _ = QFileDialog.getOpenFileName(self, "Seleccionar Icono", initial_dir, "Images (*.png *.ico);;All Files (*)")
        if path:
            self.inp_app_icon.setText(path)

    def _clear_ilum_memory(self):
        from PyQt6.QtWidgets import QMessageBox
        reply = QMessageBox.question(self, "Confirmar Limpieza", "¿Estás seguro de que quieres borrar TODA la memoria a largo plazo de ILUM?\nEsto olvidará tus notas, hábitos y contexto de conversaciones pasadas.",
                                     QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No, QMessageBox.StandardButton.No)
        if reply == QMessageBox.StandardButton.Yes:
            try:
                from memory.memory_manager import forget_memory
                forget_memory()
                QMessageBox.information(self, "Memoria Limpia", "La memoria de ILUM ha sido borrada exitosamente.")
            except Exception as e:
                QMessageBox.warning(self, "Error", f"No se pudo limpiar la memoria: {e}")

    def load_settings(self):
        self.cmb_camera.clear()
        try:
            from PyQt6.QtMultimedia import QMediaDevices
            cameras = QMediaDevices.videoInputs()
            if not cameras:
                self.cmb_camera.addItem("No se detectaron camaras", -1)
                self.cmb_camera.addItem("Camara Principal (Indice 0)", 0)
                self.cmb_camera.addItem("Camara Secundaria (Indice 1)", 1)
                self.cmb_camera.addItem("Camara Externa (Indice 2)", 2)
            else:
                for i, cam in enumerate(cameras):
                    desc = cam.description()
                    self.cmb_camera.addItem(f"{desc} (Indice {i})", i)
        except Exception:
            self.cmb_camera.addItem("Camara Principal (Indice 0)", 0)
            self.cmb_camera.addItem("Camara Secundaria (Indice 1)", 1)
            self.cmb_camera.addItem("Camara Externa (Indice 2)", 2)
 
        try:
            import sounddevice as sd
            devices = sd.query_devices()
            
            self.cmb_mic.addItem("Default Microphone Input", "")
            for i, dev in enumerate(devices):
                if dev.get("max_input_channels", 0) > 0:
                    self.cmb_mic.addItem(dev["name"], i)
                    
            self.cmb_speaker.addItem("Default Speaker Output", "")
            for i, dev in enumerate(devices):
                if dev.get("max_output_channels", 0) > 0:
                    self.cmb_speaker.addItem(dev["name"], i)
        except Exception:
            pass
            
        try:
            from memory.config_manager import load_api_keys
            cfg = load_api_keys()
            
            self.inp_app_icon.setText(cfg.get("ilum_app_icon", ""))
            self.inp_gemini.setText(cfg.get("gemini_api_key", ""))
            self.inp_openrouter.setText(cfg.get("openrouter_api_key", ""))
            self.inp_openrouter_model.setText(cfg.get("openrouter_model", "google/gemini-2.5-flash"))
            self.chk_gpu.setChecked(cfg.get("gpu_acceleration", False))
            
            # Load widgets HUD options
            self.chk_chat_bar.setChecked(cfg.get("enable_chat_bar", False))
            self.chk_dynamic_mic.setChecked(cfg.get("enable_dynamic_mic", False))
            self.chk_student_glass.setChecked(cfg.get("student_glass_mode", True))
            
            prov = cfg.get("ai_provider", "gemini")
            idx = self.cmb_ai_provider.findData(prov)
            if idx >= 0: self.cmb_ai_provider.setCurrentIndex(idx)
            
            voice = cfg.get("ilum_voice", "Aoede")
            for idx in range(self.cmb_voice.count()):
                if self.cmb_voice.itemData(idx) == voice:
                    self.cmb_voice.setCurrentIndex(idx)
                    break
                    
            # Load Fish Audio settings
            self.chk_fish_audio.setChecked(cfg.get("fish_audio_enabled", False))
            self.inp_fish_api_key.setText(cfg.get("fish_api_key", ""))
            self.inp_fish_voice_id.setText(cfg.get("fish_voice_id", ""))
            self._toggle_fish_audio_fields()

            # Load Local TTS settings
            self.chk_local_tts.setChecked(cfg.get("local_tts_enabled", False))
            self._toggle_local_tts_fields()

            self.inp_ollama_url.setText(cfg.get("ollama_url", "http://127.0.0.1:11434"))
            self._active_ollama_model = cfg.get("ollama_model", "gemma2:2b")
            self.refresh_ollama_model_list()
            self._toggle_ollama_fields()
            
            val = cfg.get("performance_quality", 80)
            self.sld_performance.setValue(val)
            self.lbl_performance_val.setText(f"{val}%")
            
            theme = cfg.get("ilum_theme", "gold")
            self.custom_color_hex = cfg.get("ilum_custom_theme_color", "")
            
            idx = self.cmb_theme.findData(theme)
            if idx >= 0:
                self.cmb_theme.setCurrentIndex(idx)
                
            self._toggle_theme_fields()
            if self.custom_color_hex:
                self.lbl_color_preview.setStyleSheet(f"background-color: {self.custom_color_hex}; border: 1.5px solid white; border-radius: 6px;")
                
            tz = cfg.get("timezone", "America/Lima")
            idx_tz = self.cmb_timezone.findData(tz)
            if idx_tz >= 0:
                self.cmb_timezone.setCurrentIndex(idx_tz)
                
            self.inp_user_name.setText(cfg.get("user_name", ""))
                
            mic = cfg.get("mic_device", "")
            idx = self.cmb_mic.findData(mic)
            if idx >= 0: self.cmb_mic.setCurrentIndex(idx)
            
            mic_sens = float(cfg.get("mic_sensitivity", 0.003))
            self.sld_mic_sens.setValue(int(mic_sens * 10000))
            self.lbl_mic_sens_val.setText(f"{mic_sens:.4f}")
            
            spk = cfg.get("speaker_device", "")
            idx = self.cmb_speaker.findData(spk)
            if idx >= 0: self.cmb_speaker.setCurrentIndex(idx)
            
            camera_device = cfg.get("camera_device", 0)
            try:
                camera_device = int(camera_device)
            except Exception:
                camera_device = 0
            idx_cam = self.cmb_camera.findData(camera_device)
            if idx_cam >= 0:
                self.cmb_camera.setCurrentIndex(idx_cam)
            
            self.inp_camera_ip.setText(cfg.get("camera_ip", ""))
            
            spotify_id = cfg.get("spotify_client_id", "")
            spotify_secret = cfg.get("spotify_client_secret", "")
            self.inp_spotify_id.setText(spotify_id)
            self.inp_spotify_secret.setText(spotify_secret)
            self.inp_spotify_uri.setText(cfg.get("spotify_redirect_uri", "http://127.0.0.1:8765/callback"))
            
            has_custom = bool(spotify_id or spotify_secret)
            self.chk_advanced_spotify.setChecked(has_custom)
            self._toggle_advanced_spotify(has_custom)
            
            self.lbl_spotify_status.setText(self.check_spotify_auth_status())
            
            # Load Font Family
            font_family = cfg.get("ilum_font_family", "Century Gothic")
            idx_font = self.cmb_font_family.findData(font_family)
            if idx_font >= 0:
                self.cmb_font_family.setCurrentIndex(idx_font)
            else:
                self.cmb_font_family.setCurrentText(font_family)
                
            # Load custom individual color overrides
            self._custom_bg_color = cfg.get("ilum_bg_color", "")
            self._custom_panel_color = cfg.get("ilum_panel_color", "")
            self._custom_text_color = cfg.get("ilum_text_color", "")
            
            # Load background image and opacity
            self._custom_bg_image = cfg.get("ilum_bg_image", "")
            bg_op = int(float(cfg.get("ilum_bg_opacity", 0.85)) * 100)
            self.sld_bg_opacity.setValue(bg_op)
            self.lbl_bg_opacity_val.setText(f"{bg_op}%")
            
            # Load sticker configuration
            self._custom_sticker_path = cfg.get("ilum_sticker_path", "")
            self.sld_sticker_w.setValue(int(cfg.get("ilum_sticker_w", 100)))
            self.sld_sticker_h.setValue(int(cfg.get("ilum_sticker_h", 100)))
            self.sld_sticker_x.setValue(int(cfg.get("ilum_sticker_x", 50)))
            self.sld_sticker_y.setValue(int(cfg.get("ilum_sticker_y", 50)))
            self._update_sticker_preview()

            # Dynamic Ollama Status check on load
            self.check_ollama_status()

            # Load AI Name
            self.inp_ai_name.setText(cfg.get("ai_name", ""))

            # Load Widget Visibility settings
            self.chk_widget_spotify.setChecked(cfg.get("show_widget_spotify", True))
            self.chk_widget_weather.setChecked(cfg.get("show_widget_weather", True))
            self.chk_widget_system.setChecked(cfg.get("show_widget_system", True))
            self.chk_widget_todo.setChecked(cfg.get("show_widget_todo", True))
            self.chk_widget_notes.setChecked(cfg.get("show_widget_notes", True))
            self.chk_widget_files.setChecked(cfg.get("show_widget_files", True))

            # Load Personalities configuration
            try:
                self.cmb_personality.blockSignals(True)
                self.cmb_personality.clear()
                from memory.config_manager import BASE_DIR
                import json
                pers_path = BASE_DIR / "config" / "personalities.json"
                if pers_path.exists():
                    pers_data = json.loads(pers_path.read_text(encoding="utf-8"))
                    self._personalities_dict = pers_data.get("personalities", {})
                    active_key = pers_data.get("active", "actual")
                    
                    for k, v in self._personalities_dict.items():
                        self.cmb_personality.addItem(v["name"], k)
                        
                    idx = self.cmb_personality.findData(active_key)
                    if idx >= 0:
                        self.cmb_personality.setCurrentIndex(idx)
                    else:
                        self.cmb_personality.setCurrentIndex(0)
                    self.cmb_personality.blockSignals(False)
                    
                    curr_key = self.cmb_personality.currentData()
                    if curr_key in self._personalities_dict:
                        self.txt_personality_prompt.setPlainText(self._personalities_dict[curr_key]["prompt"])
                else:
                    self.cmb_personality.blockSignals(False)
            except Exception as e:
                print(f"Error loading personalities configurations: {e}")
                try: self.cmb_personality.blockSignals(False)
                except: pass
            
        except Exception:
            pass

    def apply_changes(self):
        self._do_save(close_after_save=False)

    def save(self):
        self._do_save(close_after_save=True)

    def _do_save(self, close_after_save=True):
        try:
            from memory.config_manager import save_api_keys, load_api_keys
            theme_val = self.cmb_theme.currentData()
            custom_hex_val = self.custom_color_hex if theme_val == "custom" else ""
            
            camera_device_val = self.cmb_camera.currentData()
            if camera_device_val is None:
                camera_device_val = 0

            # Load existing config first to preserve runtime-saved keys (e.g. window positions)
            cfg = load_api_keys()
            cfg.update({
                "ilum_app_icon": self.inp_app_icon.text().strip(),
                "ai_name": self.inp_ai_name.text().strip(),
                "gemini_api_key": self.inp_gemini.text().strip(),
                "openrouter_api_key": self.inp_openrouter.text().strip(),
                "openrouter_model": self.inp_openrouter_model.text().strip(),
                "ai_provider": self.cmb_ai_provider.currentData(),
                "fish_audio_enabled": self.chk_fish_audio.isChecked(),
                "fish_api_key": self.inp_fish_api_key.text().strip(),
                "fish_voice_id": self.inp_fish_voice_id.text().strip(),
                "local_tts_enabled": self.chk_local_tts.isChecked(),
                "show_widget_spotify": self.chk_widget_spotify.isChecked(),
                "show_widget_weather": self.chk_widget_weather.isChecked(),
                "show_widget_system": self.chk_widget_system.isChecked(),
                "show_widget_todo": self.chk_widget_todo.isChecked(),
                "show_widget_notes": self.chk_widget_notes.isChecked(),
                "show_widget_files": self.chk_widget_files.isChecked(),
                "ollama_url": self.inp_ollama_url.text().strip(),
                "ollama_model": self.cmb_ollama_model.currentText().strip(),
                "performance_quality": self.sld_performance.value(),
                "ilum_voice": self.cmb_voice.currentData(),
                "ilum_theme": theme_val,
                "ilum_custom_theme_color": custom_hex_val,
                "gpu_acceleration": self.chk_gpu.isChecked(),
                "mic_device": self.cmb_mic.currentData(),
                "mic_sensitivity": self.sld_mic_sens.value() / 10000.0,
                "speaker_device": self.cmb_speaker.currentData(),
                "camera_device": camera_device_val,
                "camera_ip": self.inp_camera_ip.text().strip(),
                "timezone": self.cmb_timezone.currentData(),
                "user_name": self.inp_user_name.text().strip() or "Senor",
                "spotify_client_id": self.inp_spotify_id.text().strip(),
                "spotify_client_secret": self.inp_spotify_secret.text().strip(),
                "spotify_redirect_uri": self.inp_spotify_uri.text().strip(),
                "enable_chat_bar": self.chk_chat_bar.isChecked(),
                "enable_dynamic_mic": self.chk_dynamic_mic.isChecked(),
                "student_glass_mode": self.chk_student_glass.isChecked(),
                "ilum_font_family": self.cmb_font_family.currentData(),
                "ilum_bg_color": getattr(self, "_custom_bg_color", ""),
                "ilum_panel_color": getattr(self, "_custom_panel_color", ""),
                "ilum_text_color": getattr(self, "_custom_text_color", ""),
                "ilum_bg_image": getattr(self, "_custom_bg_image", ""),
                "ilum_bg_opacity": self.sld_bg_opacity.value() / 100.0,
                "ilum_sticker_path": getattr(self, "_custom_sticker_path", ""),
                "ilum_sticker_w": self.sld_sticker_w.value(),
                "ilum_sticker_h": self.sld_sticker_h.value(),
                "ilum_sticker_x": self.sld_sticker_x.value(),
                "ilum_sticker_y": self.sld_sticker_y.value()
            })
            save_api_keys(cfg)
            
            try:
                from memory.memory_manager import update_memory
                tz_map = {
                    "America/Mexico_City": "Ciudad de Mexico",
                    "America/Bogota": "Bogota",
                    "America/Argentina/Buenos_Aires": "Buenos Aires",
                    "America/Santiago": "Santiago",
                    "America/Caracas": "Caracas",
                    "Europe/Madrid": "Madrid",
                    "America/New_York": "New York",
                    "America/Lima": "Lima"
                }
                new_tz = self.cmb_timezone.currentData()
                if new_tz in tz_map:
                    update_memory({"identity": {"city": {"value": tz_map[new_tz]}}})
            except Exception as e:
                print(f"[UI] Error updating memory city from tz: {e}")
                
            # Save active personality configurations
            self._save_personalities_file()
            
            apply_theme_tokens(theme_val, custom_hex_val)
            
            parent = self.parent()
            if parent:
                parent.update_theme_styles()
                if hasattr(parent, "update_widgets_visibility"):
                    parent.update_widgets_visibility()
                if hasattr(parent, "orb") and parent.orb:
                    parent.orb.web_view.page().runJavaScript(
                        f"if (window.updatePerformance) window.updatePerformance({self.sld_performance.value()});"
                    )
                
                # Apply icon dynamically
                from PyQt6.QtGui import QIcon, QImage
                from pathlib import Path
                import os
                
                app_icon = cfg.get("ilum_app_icon", "")
                icon_path_for_shortcut = ""
                
                if app_icon and Path(app_icon).exists():
                    parent.setWindowIcon(QIcon(app_icon))
                    
                    # Preparar icono .ico para el acceso directo
                    if app_icon.lower().endswith(".png"):
                        from memory.config_manager import BASE_DIR
                        ico_path = str(BASE_DIR / "assets" / "current_icon.ico")
                        img = QImage(app_icon)
                        if img.save(ico_path, "ICO"):
                            icon_path_for_shortcut = ico_path
                        else:
                            icon_path_for_shortcut = app_icon
                    else:
                        icon_path_for_shortcut = app_icon
                        
                else:
                    def_icon = get_bundled_path("assets", "ilum_icono.ico")
                    if def_icon.exists():
                        parent.setWindowIcon(QIcon(str(def_icon)))
                        icon_path_for_shortcut = str(def_icon)
                
                # Actualizar accesos directos en el escritorio
                if icon_path_for_shortcut and icon_path_for_shortcut.lower().endswith(".ico"):
                    try:
                        import win32com.client
                        shell = win32com.client.Dispatch("WScript.Shell")
                        desktop = os.path.join(os.environ.get("USERPROFILE", ""), "Desktop")
                        for link_name in ["ILUM.lnk", "ILUM AI.lnk", "JARVIS.lnk"]:
                            lnk_path = os.path.join(desktop, link_name)
                            if os.path.exists(lnk_path):
                                shortcut = shell.CreateShortcut(lnk_path)
                                shortcut.IconLocation = icon_path_for_shortcut
                                shortcut.Save()
                    except Exception as e:
                        print(f"Error actualizando shortcut: {e}")
                
            if close_after_save:
                QMessageBox.information(self, "Success", "ILUM Configurations saved, sir.")
                self.accept()
            else:
                # Also trigger session reconnect for apply changes (so personality is applied)
                parent = self.parent()
                if parent and hasattr(parent, "ui") and parent.ui.on_config_saved:
                    parent.ui.on_config_saved(load_api_keys())
                IlumMessageBox(self, "Success", "ILUM Configurations applied dynamically, sir.").exec()
        except Exception as e:
            IlumMessageBox(self, "Error", f"Failed to save settings: {e}", is_error=True).exec()
 
    def check_spotify_auth_status(self):
        try:
            client_id = self.inp_spotify_id.text().strip() or "455d312ba37a4e0c8be373b53f6305a4"
            client_secret = self.inp_spotify_secret.text().strip() or "5a075d9e504c4f3cb4cc6c5e533d1b4a"
            redirect_uri = self.inp_spotify_uri.text().strip() or "http://127.0.0.1:8765/callback"
            
            from memory.config_manager import BASE_DIR
            import spotipy
            from spotipy.oauth2 import SpotifyOAuth
            sp_oauth = SpotifyOAuth(
                client_id=client_id,
                client_secret=client_secret,
                redirect_uri=redirect_uri,
                open_browser=False,
                cache_path=str(BASE_DIR / ".spotify_cache")
            )
            token = sp_oauth.get_cached_token()
            if token:
                self.lbl_spotify_status.setStyleSheet("color: #1DB954; font-weight: bold;")
                return "Conectado"
            else:
                self.lbl_spotify_status.setStyleSheet("color: #e11d48; font-weight: bold;")
                return "Desconectado"
        except Exception as e:
            self.lbl_spotify_status.setStyleSheet("color: #e11d48; font-style: italic;")
            return f"Error: {e}"
 
    def connect_spotify(self):
        import threading
        import webbrowser
        from pathlib import Path as _Path
        from http.server import HTTPServer, BaseHTTPRequestHandler
        import urllib.parse
        import json
 
        client_id = self.inp_spotify_id.text().strip() or "455d312ba37a4e0c8be373b53f6305a4"
        client_secret = self.inp_spotify_secret.text().strip() or "5a075d9e504c4f3cb4cc6c5e533d1b4a"
        
        custom_redirect_uri = self.inp_spotify_uri.text().strip() or "http://127.0.0.1:8765/callback"
        try:
            parsed_uri = urllib.parse.urlparse(custom_redirect_uri)
            port = parsed_uri.port or 8765
        except Exception:
            port = 8765
            
        redirect_uri = f"http://127.0.0.1:{port}/callback"
 
        self.lbl_spotify_status.setText("Abriendo navegador...")
        self.lbl_spotify_status.setStyleSheet("color: #fbbf24; font-style: italic;")
        self.btn_spotify_login.setEnabled(False)
 
        auth_html_path = get_bundled_path("assets", "spotify_auth.html")
        from memory.config_manager import BASE_DIR
        import spotipy
        from spotipy.oauth2 import SpotifyOAuth
        sp_oauth = SpotifyOAuth(
            client_id=client_id,
            client_secret=client_secret,
            redirect_uri=redirect_uri,
            scope="user-modify-playback-state user-read-playback-state user-read-currently-playing user-library-read user-library-modify",
            open_browser=False,
            cache_path=str(BASE_DIR / ".spotify_cache")
        )
        auth_url = sp_oauth.get_authorize_url()
 
        auth_complete = threading.Event()
        auth_result = {"success": False, "error": ""}
        outer_self = self
 
        class _SpotifyCallbackHandler(BaseHTTPRequestHandler):
            def log_message(self, *args): pass
 
            def _send_json(self, data: dict, code: int = 200):
                body = json.dumps(data).encode("utf-8")
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Access-Control-Allow-Origin", "*")
                self.end_headers()
                self.wfile.write(body)
 
            def _serve_file(self, path: str):
                try:
                    with open(path, "rb") as f:
                        content = f.read()
                    ext = path.rsplit(".", 1)[-1]
                    ctype = {"html": "text/html", "css": "text/css", "js": "application/javascript"}.get(ext, "text/plain")
                    self.send_response(200)
                    self.send_header("Content-Type", f"{ctype}; charset=utf-8")
                    self.send_header("Content-Length", str(len(content)))
                    self.end_headers()
                    self.wfile.write(content)
                except Exception:
                    self.send_response(404)
                    self.end_headers()
 
            def do_OPTIONS(self):
                self.send_response(200)
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
                self.send_header("Access-Control-Allow-Headers", "Content-Type")
                self.end_headers()
 
            def do_GET(self):
                parsed = urllib.parse.urlparse(self.path)
                qs = urllib.parse.parse_qs(parsed.query)
 
                if parsed.path == "/" or parsed.path == "/index.html":
                    self._serve_file(str(auth_html_path))
 
                elif parsed.path == "/callback":
                    code = qs.get("code", [None])[0]
                    error = qs.get("error", [None])[0]
                    if error:
                        auth_result["error"] = error
                        self._send_json({"status": "error", "message": error})
                        auth_complete.set()
                    elif code:
                        try:
                            sp_oauth.get_access_token(code, as_dict=False)
                            auth_result["success"] = True
                            success_html = (
                                "<!DOCTYPE html>"
                                "<html lang='es'>"
                                "<head>"
                                "  <meta charset='utf-8'>"
                                "  <meta name='viewport' content='width=device-width, initial-scale=1.0'>"
                                "  <title>ILUM - Conectado</title>"
                                "  <link href='https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&display=swap' rel='stylesheet'>"
                                "  <style>"
                                "    body { background: #060400; color: #fde68a; font-family: 'Outfit', sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }"
                                "    .container { text-align: center; background: rgba(28, 20, 4, 0.85); border: 1.5px solid rgba(245, 158, 11, 0.4); border-radius: 20px; padding: 40px; box-shadow: 0 0 40px rgba(29, 185, 84, 0.15); max-width: 90%; width: 400px; animation: entry 0.5s ease-out; }"
                                "    h1 { color: #fff; font-size: 24px; margin-top: 15px; margin-bottom: 10px; }"
                                "    p { color: rgba(253, 230, 138, 0.6); font-size: 14px; line-height: 1.5; }"
                                "    .icon-wrapper { display: flex; justify-content: center; margin-bottom: 20px; }"
                                "    @keyframes entry { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }"
                                "  </style>"
                                "</head>"
                                "<body>"
                                "  <div class='container'>"
                                "    <div class='icon-wrapper'>"
                                "      <svg width='64' height='64' viewBox='0 0 24 24' fill='none' stroke='#1DB954' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>"
                                "        <path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'></path>"
                                "        <polyline points='22 4 12 14.01 9 11.01'></polyline>"
                                "      </svg>"
                                "    </div>"
                                "    <h1>Spotify Conectado</h1>"
                                "    <p>La vinculacion con ILUM se ha completado con exito.<br>Ya puedes cerrar esta pestana y volver a la aplicacion.</p>"
                                "  </div>"
                                "</body>"
                                "</html>"
                            ).encode("utf-8")
 
                            self.send_response(200)
                            self.send_header("Content-Type", "text/html; charset=utf-8")
                            self.end_headers()
                            self.wfile.write(success_html)
                            auth_complete.set()
                        except Exception as ex:
                            auth_result["error"] = str(ex)
                            self._send_json({"status": "error", "message": str(ex)})
                            auth_complete.set()
                    else:
                        self._send_json({"status": "error", "message": "Sin codigo"})
 
                elif parsed.path == "/spotify/status":
                    connected = auth_result["success"]
                    self._send_json({"connected": connected})
 
                else:
                    self.send_response(404)
                    self.end_headers()
 
            def do_POST(self):
                parsed = urllib.parse.urlparse(self.path)
                if parsed.path == "/spotify/auth":
                    self._send_json({"status": "ok", "message": "Auth URL generated", "auth_url": auth_url})
                else:
                    self.send_response(404)
                    self.end_headers()
 
        def _run_server():
            try:
                server = HTTPServer(("127.0.0.1", port), _SpotifyCallbackHandler)
                server.timeout = 1.0
                deadline = 300  # Max 5 minutes
                elapsed = 0
                while not auth_complete.is_set() and elapsed < deadline:
                    server.handle_request()
                    elapsed += 1
                server.server_close()
 
                if auth_result["success"]:
                    QTimer.singleShot(0, outer_self.spotify_auth_success)
                else:
                    err = auth_result.get("error", "Tiempo agotado o cancelado")
                    QTimer.singleShot(0, lambda: outer_self.spotify_auth_failed(err))
            except Exception as ex:
                QTimer.singleShot(0, lambda: outer_self.spotify_auth_failed(str(ex)))
 
        threading.Thread(target=_run_server, daemon=True).start()
 
        def _open_browser():
            import time
            time.sleep(0.5)  # Let server start
            webbrowser.open(auth_url)
 
        threading.Thread(target=_open_browser, daemon=True).start()
 
    def spotify_auth_success(self):
        self.btn_spotify_login.setEnabled(True)
        self.lbl_spotify_status.setText("Conectado")
        self.lbl_spotify_status.setStyleSheet("color: #1DB954; font-weight: bold;")
        IlumMessageBox(self, "Spotify API", "¡Autenticacion con Spotify exitosa, sir!").exec()
 
    def spotify_auth_failed(self, error):
        self.btn_spotify_login.setEnabled(True)
        self.lbl_spotify_status.setText("Error")
        self.lbl_spotify_status.setStyleSheet("color: #e11d48; font-weight: bold;")
        IlumMessageBox(self, "Spotify API Error", f"Fallo al conectar: {error}", is_error=True).exec()
 
    def check_ollama_status(self):
        url = self.inp_ollama_url.text().strip() or "http://127.0.0.1:11434"
        self._is_checking_ollama = True
        self.lbl_ollama_status.setText("ESTADO: COMPROBANDO...")
        self.lbl_ollama_status.setStyleSheet("color: #cbd5e1; font-weight: bold; font-size: 11px; letter-spacing: 1.5px;")
        
        self.check_worker = OllamaCheckWorker(url)
        if self.parent():
            self.check_worker.setParent(self.parent())
        self.check_worker.finished_signal.connect(self.on_check_finished)
        self.check_worker.start()

    def on_check_finished(self, is_online, models, version):
        self._is_checking_ollama = False
        if is_online:
            v_str = f" (v{version})" if version else ""
            self.lbl_ollama_status.setText(f"ESTADO: OLLAMA ONLINE{v_str}")
            self.lbl_ollama_status.setStyleSheet("color: #00ff88; font-weight: bold; font-size: 11px; letter-spacing: 1.5px;")
            self.update_model_states(models)
            
            # Dynamic ComboBox loading
            current = self.cmb_ollama_model.currentText()
            self.cmb_ollama_model.blockSignals(True)
            self.cmb_ollama_model.clear()
            for m in models:
                self.cmb_ollama_model.addItem(m, m)
            
            target_model = getattr(self, "_active_ollama_model", current)
            if target_model:
                idx = self.cmb_ollama_model.findText(target_model)
                if idx >= 0:
                    self.cmb_ollama_model.setCurrentIndex(idx)
                else:
                    self.cmb_ollama_model.addItem(target_model, target_model)
                    self.cmb_ollama_model.setCurrentText(target_model)
            if self.cmb_ollama_model.count() == 0:
                self.cmb_ollama_model.addItem("gemma2:2b", "gemma2:2b")
            self.cmb_ollama_model.blockSignals(False)
        else:
            self.lbl_ollama_status.setText("ESTADO: OLLAMA OFFLINE")
            self.lbl_ollama_status.setStyleSheet("color: #ff3b30; font-weight: bold; font-size: 11px; letter-spacing: 1.5px;")
            self.update_model_states([])

    def update_model_states(self, downloaded_models):
        for code, info in self.model_cards.items():
            is_downloaded = False
            for dm in downloaded_models:
                if dm == code or dm.split(":")[0] == code.split(":")[0]:
                    is_downloaded = True
                    break
            
            lbl_status = info["lbl_status"]
            btn_action = info["btn_action"]
            
            try: btn_action.clicked.disconnect()
            except: pass
            
            if is_downloaded:
                lbl_status.setText("DESCARGADO")
                lbl_status.setStyleSheet("color: #00ff88; font-weight: bold; font-size: 9px; letter-spacing: 1px; background: transparent;")
                btn_action.setText("SELECCIONAR COMO CEREBRO")
                btn_action.setStyleSheet(f"""
                    QPushButton {{
                        background-color: rgba(255, 255, 255, 0.05);
                        color: #00ff88;
                        border: 1px solid #00ff8888;
                        border-radius: 3px;
                        font-weight: bold;
                        font-size: 9px;
                        letter-spacing: 1px;
                    }}
                    QPushButton:hover {{
                        background-color: #00ff88;
                        color: black;
                    }}
                """)
                btn_action.clicked.connect(lambda checked, c=code: self.select_active_ollama_model(c))
            else:
                lbl_status.setText("DISPONIBLE")
                lbl_status.setStyleSheet("color: #a1a1aa; font-weight: bold; font-size: 9px; letter-spacing: 1px; background: transparent;")
                btn_action.setText("DESCARGAR")
                btn_action.setStyleSheet(f"""
                    QPushButton {{
                        background-color: transparent;
                        color: {C_PRI};
                        border: 1px solid {C_PRI};
                        border-radius: 3px;
                        font-weight: bold;
                        font-size: 9px;
                        letter-spacing: 1px;
                    }}
                    QPushButton:hover {{
                        background-color: {C_PRI};
                        color: black;
                    }}
                """)
                btn_action.clicked.connect(lambda checked, c=code: self.start_pull(c))

    def select_active_ollama_model(self, model_name):
        idx = self.cmb_ai_provider.findData("ollama")
        if idx >= 0:
            self.cmb_ai_provider.setCurrentIndex(idx)
        self.refresh_ollama_model_list()
        idx_model = self.cmb_ollama_model.findText(model_name)
        if idx_model >= 0:
            self.cmb_ollama_model.setCurrentIndex(idx_model)
        else:
            self.cmb_ollama_model.addItem(model_name, model_name)
            self.cmb_ollama_model.setCurrentText(model_name)
        self.tabs.setCurrentIndex(0)
        IlumMessageBox(self, "SUCCESS", f"MODELO {model_name.upper()} SELECCIONADO COMO CEREBRO.").exec()

    def start_install_ollama(self):
        for info in self.model_cards.values():
            info["btn_action"].setEnabled(False)
        self.btn_custom_pull.setEnabled(False)
        if hasattr(self, "btn_install_ollama"):
            self.btn_install_ollama.setEnabled(False)
        
        self.lbl_progress_status.setText("INICIANDO DESCARGA DEL INSTALADOR")
        self.bar_pull_progress.setValue(0)
        self.btn_cancel_pull.setEnabled(True)
        
        self.install_worker = OllamaInstallerWorker()
        if self.parent():
            self.install_worker.setParent(self.parent())
        self.install_worker.progress_signal.connect(self.on_pull_progress)
        self.install_worker.start()

    def start_pull(self, model_name):
        url = self.inp_ollama_url.text().strip() or "http://127.0.0.1:11434"
        for info in self.model_cards.values():
            info["btn_action"].setEnabled(False)
        self.btn_custom_pull.setEnabled(False)
        
        self.lbl_progress_status.setText(f"INICIANDO DESCARGA: {model_name.upper()}")
        self.bar_pull_progress.setValue(0)
        self.btn_cancel_pull.setEnabled(True)
        
        self.pull_worker = OllamaPullWorker(model_name, url)
        if self.parent():
            self.pull_worker.setParent(self.parent())
        self.pull_worker.progress_signal.connect(self.on_pull_progress)
        self.pull_worker.start()

    def on_pull_progress(self, status, percent, error):
        if status == "success":
            self.lbl_progress_status.setText("DESCARGA COMPLETADA CON EXITO")
            self.bar_pull_progress.setValue(100)
            self.finish_pull()
            IlumMessageBox(self, "SUCCESS", "DESCARGA DE MODELO COMPLETADA.").exec()
        elif status == "success_installer":
            self.lbl_progress_status.setText("INSTALADOR ABIERTO CON EXITO")
            self.bar_pull_progress.setValue(100)
            self.finish_pull()
            IlumMessageBox(self, "SUCCESS", "SIGUE LOS PASOS DEL INSTALADOR DE OLLAMA Y LUEGO DESCARGA UN MODELO.").exec()
        elif status == "cancelled":
            self.lbl_progress_status.setText("DESCARGA CANCELADA")
            self.bar_pull_progress.setValue(0)
            self.finish_pull()
        elif status == "error":
            self.lbl_progress_status.setText(f"ERROR: {error.upper()}")
            self.bar_pull_progress.setValue(0)
            self.finish_pull()
            IlumMessageBox(self, "ERROR", f"Fallo al descargar modelo:\n{error}", is_error=True).exec()
        else:
            self.lbl_progress_status.setText(f"{status.upper()}: {percent}%")
            self.bar_pull_progress.setValue(percent)

    def cancel_pull(self):
        if hasattr(self, "pull_worker") and self.pull_worker.isRunning():
            self.lbl_progress_status.setText("CANCELANDO DESCARGA...")
            self.pull_worker.is_running = False
            self.pull_worker.wait()
            self.finish_pull()

    def finish_pull(self):
        for info in self.model_cards.values():
            info["btn_action"].setEnabled(True)
        self.btn_custom_pull.setEnabled(True)
        if hasattr(self, "btn_install_ollama"):
            self.btn_install_ollama.setEnabled(True)
        self.btn_cancel_pull.setEnabled(False)
        self.check_ollama_status()

    def pull_custom_model(self):
        model = self.inp_custom_model.text().strip()
        if not model:
            IlumMessageBox(self, "WARNING", "POR FAVOR, DIGITA UN NOMBRE DE MODELO VÁLIDO.", is_error=True).exec()
            return
        self.start_pull(model)

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.drag_position = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
            event.accept()
 
    def mouseMoveEvent(self, event):
        if event.buttons() == Qt.MouseButton.LeftButton and hasattr(self, 'drag_position') and self.drag_position is not None:
            self.move(event.globalPosition().toPoint() - self.drag_position)
            event.accept()

