            ("Gold", "#f59e0b"),
            ("Pink", "#ff007f"),
            ("Azure", "#007fff"),
            ("Silver", "#e2e8f0")
        ]
        
        for idx, (name, hex_val) in enumerate(self.presets):
            row = idx // 4
            col = idx % 4
            btn = QPushButton()
            btn.setFixedSize(65, 26)
            btn.setText(name.upper())
            btn.setCursor(Qt.CursorShape.PointingHandCursor)
            
            btn.setStyleSheet(f"""
                QPushButton {{
                    background-color: rgba(0, 0, 0, 0.4);
                    color: {hex_val};
                    border: 1px solid {hex_val}88;
                    border-radius: 4px;
                    font-size: 8px;
                    font-weight: bold;
                }}
                QPushButton:hover {{
                    background-color: {hex_val};
                    color: black;
                }}
            """)
            btn.clicked.connect(lambda checked, h=hex_val: self.set_hex_color(h))
            presets_grid.addWidget(btn, row, col)
            
        container_layout.addLayout(presets_grid)
        
        # Apply button
        self.btn_apply = QPushButton("APLICAR COLOR HUD")
        self.btn_apply.setFixedHeight(35)
        self.btn_apply.clicked.connect(self.accept)
        container_layout.addWidget(self.btn_apply)
        
        # Stylesheet setup
        self.setStyleSheet(f"""
            QFrame#pickerContainer {{
                background-color: {C_BG};
                border: 2.2px solid {C_PRI};
                border-radius: 12px;
            }}
            QLabel {{
                color: {C_TEXT};
                font-weight: bold;
                font-size: 11px;
                background: transparent;
            }}
            QLineEdit {{
                background: rgba(0,0,0,0.6);
                border: 1px solid {C_BORDER};
                color: white;
                padding: 4px;
                border-radius: 4px;
                font-weight: bold;
                font-size: 12px;
            }}
            QPushButton {{
                background-color: {C_PRI};
                color: black;
                border: 1px solid {C_PRI};
                font-weight: bold;
                border-radius: 6px;
                font-size: 11px;
                letter-spacing: 1px;
            }}
            QPushButton:hover {{
                background-color: transparent;
                color: {C_PRI};
            }}
            QSlider::groove:horizontal {{
                border: 1px solid rgba(255, 255, 255, 0.1);
                height: 6px;
                background: rgba(0, 0, 0, 0.5);
                border-radius: 3px;
            }}
            QSlider::handle:horizontal {{
                background: {C_PRI};
                width: 14px;
                margin: -4px 0px;
                border-radius: 7px;
            }}
        """)
        
        main_v = QVBoxLayout(self)
        main_v.setContentsMargins(0, 0, 0, 0)
        main_v.addWidget(self.container)
        
        h, s, v, a = self.selected_color.getHsv()
        self.sld_h.setValue(h)
        self.sld_s.setValue(s)
        self.sld_v.setValue(v)
        self.lbl_h_val.setText(str(h))
        self.lbl_s_val.setText(str(s))
        self.lbl_v_val.setText(str(v))
        self.inp_hex.setText(self.selected_color.name().upper())
        self._update_preview()
        
    def _on_slider_changed(self):
        h = self.sld_h.value()
        s = self.sld_s.value()
        v = self.sld_v.value()
        self.lbl_h_val.setText(str(h))
        self.lbl_s_val.setText(str(s))
        self.lbl_v_val.setText(str(v))
        
        self.selected_color = QColor.fromHsv(h, s, v)
        
        self.inp_hex.blockSignals(True)
        self.inp_hex.setText(self.selected_color.name().upper())
        self.inp_hex.blockSignals(False)
        
        self._update_preview()
        
    def _on_hex_input_changed(self, text):
        c = QColor(text)
        if c.isValid():
            self.selected_color = c
            h, s, v, a = c.getHsv()
            
            self.sld_h.blockSignals(True)
            self.sld_s.blockSignals(True)
            self.sld_v.blockSignals(True)
            self.sld_h.setValue(h)
            self.sld_s.setValue(s)
            self.sld_v.setValue(v)
            self.sld_h.blockSignals(False)
            self.sld_s.blockSignals(False)
            self.sld_v.blockSignals(False)
            
            self.lbl_h_val.setText(str(h))
            self.lbl_s_val.setText(str(s))
            self.lbl_v_val.setText(str(v))
            
            self._update_preview()
            
    def set_hex_color(self, hex_val):
        self.inp_hex.setText(hex_val.upper())
        
    def _update_preview(self):
        c = self.selected_color.name()
        self.preview_frame.setStyleSheet(f"background-color: {c}; border: 2.5px solid white; border-radius: 40px;")
        self.glow_effect.setColor(self.selected_color)
        
    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.drag_position = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
            event.accept()

    def mouseMoveEvent(self, event):
        if event.buttons() == Qt.MouseButton.LeftButton and hasattr(self, 'drag_position') and self.drag_position is not None:
            self.move(event.globalPosition().toPoint() - self.drag_position)
            event.accept()


class OllamaPullWorker(QThread):
    progress_signal = pyqtSignal(str, int, str)  # status, percentage, error_msg

    def __init__(self, model_name, ollama_url="http://127.0.0.1:11434"):
        super().__init__()
        self.model_name = model_name
        self.ollama_url = ollama_url.rstrip("/")
        self.is_running = True

    def run(self):
        import urllib.request
        import json
        
        url = f"{self.ollama_url}/api/pull"
        data = json.dumps({"name": self.model_name}).encode("utf-8")
        req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
        
        try:
            response = urllib.request.urlopen(req, timeout=1200) # 20 minutes timeout
            buffer = ""
            while self.is_running:
                chunk = response.read(256)
                if not chunk:
                    break
                buffer += chunk.decode("utf-8", errors="ignore")
                
                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        resp_json = json.loads(line)
                        status = resp_json.get("status", "")
                        completed = resp_json.get("completed", 0)
                        total = resp_json.get("total", 0)
                        
                        percent = 0
                        if total > 0:
                            percent = int((completed / total) * 100)
                            
                        self.progress_signal.emit(status, percent, "")
                    except Exception:
                        pass
            
            if self.is_running:
                self.progress_signal.emit("success", 100, "")
            else:
                self.progress_signal.emit("cancelled", 0, "")
        except Exception as e:
            self.progress_signal.emit("error", 0, str(e))

class OllamaInstallerWorker(QThread):
    progress_signal = pyqtSignal(str, int, str)
    
    def __init__(self):
        super().__init__()
        self.is_running = True
        
    def run(self):
        import urllib.request
        import os
        import tempfile
        url = "https://ollama.com/download/OllamaSetup.exe"
        exe_path = os.path.join(tempfile.gettempdir(), "OllamaSetup.exe")
        
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=30) as response:
                total_length = response.getheader('content-length')
                if total_length is None:
                    self.progress_signal.emit("DESCARGANDO INSTALADOR...", 50, "")
                    with open(exe_path, 'wb') as f:
                        f.write(response.read())
                else:
                    total_length = int(total_length)
                    downloaded = 0
                    chunk_size = 1024 * 64
                    with open(exe_path, 'wb') as f:
                        while self.is_running:
                            chunk = response.read(chunk_size)
                            if not chunk:
                                break
                            f.write(chunk)
                            downloaded += len(chunk)
                            percent = int((downloaded / total_length) * 100)
                            self.progress_signal.emit("DESCARGANDO INSTALADOR", percent, "")
                            
            if self.is_running:
                self.progress_signal.emit("EJECUTANDO INSTALADOR...", 100, "")
                os.startfile(exe_path)
                self.progress_signal.emit("success_installer", 100, "")
            else:
                self.progress_signal.emit("cancelled", 0, "")
        except Exception as e:
            self.progress_signal.emit("error", 0, str(e))


class OllamaCheckWorker(QThread):
    finished_signal = pyqtSignal(bool, list, str)  # is_online, models, version

    def __init__(self, ollama_url="http://127.0.0.1:11434"):
        super().__init__()
        self.ollama_url = ollama_url.rstrip("/")

    def run(self):
        import urllib.request
        import json
        url = f"{self.ollama_url}/api/tags"
        try:
            req = urllib.request.Request(url, method="GET")
            with urllib.request.urlopen(req, timeout=1.2) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                models = [m["name"] for m in data.get("models", [])]
                
                version = ""
                try:
                    req_v = urllib.request.Request(f"{self.ollama_url}/api/version", method="GET")
                    with urllib.request.urlopen(req_v, timeout=0.8) as resp_v:
                        data_v = json.loads(resp_v.read().decode("utf-8"))
                        version = data_v.get("version", "")
                except:
                    pass
                
                self.finished_signal.emit(True, models, version)
        except Exception:
            self.finished_signal.emit(False, [], "")


