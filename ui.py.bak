    def reject(self):
        self.cleanup_worker()
        super().reject()
        
    def accept(self):
        self.cleanup_worker()
        super().accept()

    def closeEvent(self, event):
        self.cleanup_worker()
        super().closeEvent(event)
        
    def cleanup_worker(self):
        if hasattr(self, "check_worker") and self.check_worker:
            try:
                self.check_worker.finished_signal.disconnect()
            except:
                pass
            if self.check_worker.isRunning():
                self.check_worker.quit()
            
        if hasattr(self, "pull_worker") and self.pull_worker:
            try:
                self.pull_worker.progress_signal.disconnect()
            except:
                pass
            self.pull_worker.is_running = False
            if self.pull_worker.isRunning():
                self.pull_worker.quit()

class ResizeHandle(QWidget):
    def __init__(self, parent, position_type="BR"):
        super().__init__(parent)
        self.position_type = position_type
        self.setFixedSize(14, 14)
        self.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
        self.setStyleSheet("background-color: #f59e0b; border-radius: 7px;")
        if position_type in ("TL", "BR"):
            self.setCursor(Qt.CursorShape.SizeFDiagCursor)
        else:
            self.setCursor(Qt.CursorShape.SizeBDiagCursor)
        self._drag_pos = None

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self._drag_pos = event.globalPosition().toPoint()
            event.accept()

    def mouseMoveEvent(self, event):
        if self._drag_pos and event.buttons() == Qt.MouseButton.LeftButton:
            global_pos = event.globalPosition().toPoint()
            delta = global_pos - self._drag_pos
            self._drag_pos = global_pos
            
            w = self.parentWidget()
            geo = w.geometry()
            
            if self.position_type == "BR":
                w.setFixedSize(max(100, geo.width() + delta.x()), max(100, geo.height() + delta.y()))
            elif self.position_type == "TL":
                dx = min(delta.x(), geo.width() - 100)
                dy = min(delta.y(), geo.height() - 100)
                w.move(geo.x() + dx, geo.y() + dy)
                w.setFixedSize(geo.width() - dx, geo.height() - dy)
            elif self.position_type == "TR":
                dy = min(delta.y(), geo.height() - 100)
                w.move(geo.x(), geo.y() + dy)
                w.setFixedSize(max(100, geo.width() + delta.x()), geo.height() - dy)
            elif self.position_type == "BL":
                dx = min(delta.x(), geo.width() - 100)
                w.move(geo.x() + dx, geo.y())
                w.setFixedSize(geo.width() - dx, max(100, geo.height() + delta.y()))
                
            event.accept()

class WidgetResizeFilter(QObject):
    def eventFilter(self, obj, event):
        if event.type() == QEvent.Type.Resize:
            w = obj.width()
            h = obj.height()
            for child in obj.children():
                if isinstance(child, ResizeHandle):
                    if child.position_type == "TL":
                        child.move(0, 0)
                    elif child.position_type == "TR":
                        child.move(w - 14, 0)
                    elif child.position_type == "BL":
                        child.move(0, h - 14)
                    elif child.position_type == "BR":
                        child.move(w - 14, h - 14)
                elif child.objectName() == "EditModeDelBtn":
                    child.move(w - 30, 15)
        return False

class WidgetDragFilter(QObject):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.drag_pos = None

    def eventFilter(self, obj, event):
        if event.type() == QEvent.Type.MouseButtonPress and event.button() == Qt.MouseButton.LeftButton:
            self.drag_pos = event.pos()
            return True
        elif event.type() == QEvent.Type.MouseMove and self.drag_pos is not None:
            obj.move(obj.pos() + event.pos() - self.drag_pos)
            return True
        elif event.type() == QEvent.Type.MouseButtonRelease and event.button() == Qt.MouseButton.LeftButton:
            self.drag_pos = None
            try:
                from memory.config_manager import load_api_keys, save_api_keys
                cfg = load_api_keys()
                cfg[f"widget_pos_{obj.__class__.__name__}_x"] = obj.pos().x()
                cfg[f"widget_pos_{obj.__class__.__name__}_y"] = obj.pos().y()
                save_api_keys(cfg)
            except Exception:
                pass
            return True
        return super().eventFilter(obj, event)


class MainWindow(QMainWindow):
    _shutdown_sig = pyqtSignal()
    student_action_sig = pyqtSignal(str, dict)

    def __init__(self, ui, face_path):
        super().__init__()
        self.ui = ui
        self.ui._win = self
        self.camera_window = None
        self.student_action_sig.connect(self.handle_student_action, Qt.ConnectionType.QueuedConnection)
        
        self.resize(1150, 760)
        self.setMinimumSize(800, 600)
        self.setWindowTitle("ILUM-AI-HUD")
        
        self.setWindowFlags(self.windowFlags() | Qt.WindowType.FramelessWindowHint)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        
        self.central_widget = QWidget(self)
        self.central_widget.setObjectName("centralWidget")
        self.setCentralWidget(self.central_widget)
        
        # Initialize background image label and floating sticker label with click-through enabled
        self.lbl_bg_image = QLabel(self.central_widget)
        self.lbl_bg_image.lower()
        self.lbl_bg_image.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        self.lbl_bg_image.setStyleSheet("background: transparent;")
        
        self.lbl_sticker = QLabel(self.central_widget)
        self.lbl_sticker.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        self.lbl_sticker.setStyleSheet("background: transparent;")
        
        from memory.config_manager import load_api_keys
        cfg = load_api_keys()
        custom_icon = cfg.get("ilum_app_icon", "")
        if custom_icon and Path(custom_icon).exists():
            self.setWindowIcon(QIcon(custom_icon))
        else:
            icon_path = get_bundled_path("assets", "ilum_icono.ico")
            if icon_path.exists():
                self.setWindowIcon(QIcon(str(icon_path)))
            
        self.header_container = QWidget(self.central_widget)
        header_bar = QHBoxLayout(self.header_container)
        header_bar.setContentsMargins(15, 8, 15, 8)
        
        self.lbl_brand = QLabel("J A R V I S")
        font = QFont(FONT_FAMILY, 16, QFont.Weight.Bold)
        font.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 8.0)
        self.lbl_brand.setFont(font)
        header_bar.addWidget(self.lbl_brand)
        
        # Active Personality Badge
        self.lbl_personality_badge = QLabel("[ ILUM ]")
        self.lbl_personality_badge.setStyleSheet(f"""
            background-color: rgba(245, 158, 11, 0.08);
            color: {C_PRI};
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 4px;
            padding: 3px 8px;
            font-size: 9px;
            font-weight: bold;
            letter-spacing: 1.5px;
            margin-left: 10px;
        """)
        header_bar.addWidget(self.lbl_personality_badge)
        header_bar.addStretch()
        
        self.btn_edit_hud = QPushButton()
        self.btn_settings = QPushButton()
        self.btn_camera = QPushButton()
        self.btn_play = QPushButton()
        self.btn_suspend = QPushButton()
        self.btn_folder = QPushButton()
        self.btn_min = QPushButton()
        self.btn_close = QPushButton()
        
        self.btn_edit_hud.setToolTip("Editar / Reorganizar HUD")
        self.btn_settings.setToolTip("Ajustes de Control e Inteligencia")
        self.btn_camera.setToolTip("Piloto Gestual (Cámara HUD)")
        self.btn_play.setToolTip("Telemetría y Logs del Sistema")
        self.btn_suspend.setToolTip("Suspender / Despertar ILUM")
        
        # Widgets Panel - Absolute positioning for free movement
        self.spotify_w = SpotifyWidget(self.central_widget)
        self.system_w = SystemWidget(self.central_widget)
        self.todo_w = TodoWidget(self.central_widget)
        self.notes_w = NotesWidget(self.central_widget)
        self.files_panel = FilesPanel(self.ui)
        self.files_panel.setParent(self.central_widget)
        self.weather_w = WeatherWidget(self.central_widget)
        
        # Load positions from config or set defaults
        try:
            from memory.config_manager import load_api_keys
            cfg = load_api_keys()
            
            # Bento Grid Layout Specs:
            # Row 1 (Y=100): Spotify (500x240), Weather (240x240), System (240x240)
            # Row 2 (Y=360): Todo (240x240), Notes (500x240), Files (240x240)
            bento_specs = {
                "SpotifyWidget": {"default_pos": (60, 100), "size": (500, 240), "w_ref": self.spotify_w},
                "WeatherWidget": {"default_pos": (580, 100), "size": (240, 240), "w_ref": self.weather_w},
                "SystemWidget": {"default_pos": (840, 100), "size": (240, 240), "w_ref": self.system_w},
                "TodoWidget": {"default_pos": (60, 360), "size": (240, 240), "w_ref": self.todo_w},
                "NotesWidget": {"default_pos": (320, 360), "size": (500, 240), "w_ref": self.notes_w},
                "FilesPanel": {"default_pos": (840, 360), "size": (240, 240), "w_ref": self.files_panel},
            }
            
            for w_name, spec in bento_specs.items():
                w = spec["w_ref"]
                ww = cfg.get(f"widget_size_{w_name}_w")
                wh = cfg.get(f"widget_size_{w_name}_h")
                
                if ww is not None and wh is not None:
                    w.setFixedSize(int(ww), int(wh))
                else:
                    w.setFixedSize(*spec["size"])
                    
                wx = cfg.get(f"widget_pos_{w_name}_x")
                wy = cfg.get(f"widget_pos_{w_name}_y")
                
                # Use saved positions if valid, otherwise use perfect Bento default
                if wx is not None and wy is not None:
                    w.move(int(wx), int(wy))
                else:
                    w.move(*spec["default_pos"])
        except Exception:
            pass
        
        self.btn_folder.setToolTip("Abrir Carpeta del Proyecto")
        self.btn_min.setToolTip("Minimizar Ventana")
        self.btn_close.setToolTip("Salir de ILUM")
        
        self.head_buttons = [
            (self.btn_edit_hud, 'fa5s.sliders-h', self.toggle_hud_edit_mode),
            (self.btn_settings, 'fa5s.cog', self._open_settings),
            (self.btn_camera, 'fa5s.video', self._toggle_camera_gestures),
            (self.btn_play, 'fa5s.terminal', self._open_diagnostic_logs),
            (self.btn_suspend, 'fa5s.moon', self._toggle_suspend),
            (self.btn_folder, 'fa5s.folder', self._open_folder),
            (self.btn_min, 'fa5s.window-minimize', self.showMinimized),
            (self.btn_close, 'fa5s.times', self.close)
        ]
        
        for btn, icon, cb in self.head_buttons:
            btn.setFixedSize(28, 28)
            btn.clicked.connect(cb)
            header_bar.addWidget(btn)
            
        self.orb = CustomParticleOrb(self.ui, self.central_widget)
        
        # Bento container kept for compatibility but hidden since widgets are now free-floating
        self.bento_container = QWidget(self.central_widget)
        self.bento_container.hide()
        
        # Clean floating digital Clock Widget at top-right corner
        self.clock_w = ClockWidget(self.central_widget)
        
        # Dedicated Holographic Closed Captions Speech Area (Single centered line)
        self.txt_console = QLabel(self.central_widget)
        self.txt_console.setAlignment(Qt.AlignmentFlag.AlignBottom | Qt.AlignmentFlag.AlignHCenter)
        self.txt_console.setWordWrap(True)
        self.txt_console.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        
        # Force Close flag and System Tray initialization
        self._force_close = False
        self.tray_icon = None
        self._setup_tray_icon()
        
        # Inicializar estado de suspensión
        self.ui.is_sleeping = False
        
        self.update_theme_styles()
        self._drag_pos = None
        self._shutdown_sig.connect(self._handle_shutdown)
        self.update_widgets_visibility()
        
        # Load saved window position
        try:
            from memory.config_manager import load_api_keys
            cfg = load_api_keys()
            wx = cfg.get("window_x")
            wy = cfg.get("window_y")
            if wx is not None and wy is not None:
                self.move(int(wx), int(wy))
        except Exception:
            pass

    def update_widgets_visibility(self):
        try:
            from memory.config_manager import load_api_keys
            cfg = load_api_keys()
            enable_chat = cfg.get("enable_chat_bar", False)
            enable_mic = cfg.get("enable_dynamic_mic", False)
        except Exception:
            cfg = {}
            enable_chat = False
            enable_mic = False
            
        # Create container and widgets if they don't exist yet
        if not hasattr(self, "widget_bar_container"):
            self.widget_bar_container = QWidget(self.central_widget)
            self.widget_bar_container.setObjectName("widgetBarContainer")
            self.widget_bar_lay = QHBoxLayout(self.widget_bar_container)
            self.widget_bar_lay.setContentsMargins(0, 0, 0, 0)
            self.widget_bar_lay.setSpacing(10)
            
            # Mic button
            self.btn_dynamic_mic = QPushButton(self.widget_bar_container)
            self.btn_dynamic_mic.setFixedSize(32, 32)
            self.btn_dynamic_mic.clicked.connect(self._toggle_mute)
            self.widget_bar_lay.addWidget(self.btn_dynamic_mic)
            
            # Chat input
            self.chat_input = QLineEdit(self.widget_bar_container)
            self.chat_input.setObjectName("chatInput")
            self.chat_input.setPlaceholderText("Escriba un comando...")
            self.chat_input.returnPressed.connect(self._submit_chat_command)
            self.widget_bar_lay.addWidget(self.chat_input)
            
        # Show/Hide chat bar based on settings
        self.btn_dynamic_mic.setVisible(enable_mic)
        self.chat_input.setVisible(enable_chat)
        
        has_any = enable_mic or enable_chat
        self.widget_bar_container.setVisible(has_any)
        if hasattr(self, "central_widget") and self.central_widget.width() > 0:
            self.resizeEvent(None)
        
        # Toggle Bento HUD Widgets visibility
        if hasattr(self, "spotify_w"):
            self.spotify_w.setVisible(cfg.get("show_widget_spotify", True))
        if hasattr(self, "weather_w"):
            self.weather_w.setVisible(cfg.get("show_widget_weather", True))
        if hasattr(self, "system_w"):
            self.system_w.setVisible(cfg.get("show_widget_system", True))
        if hasattr(self, "todo_w"):
            self.todo_w.setVisible(cfg.get("show_widget_todo", True))
        if hasattr(self, "notes_w"):
            self.notes_w.setVisible(cfg.get("show_widget_notes", True))
        if hasattr(self, "files_panel"):
            self.files_panel.setVisible(cfg.get("show_widget_files", True))
        
        # Trigger dynamic relayout
        self.update_dynamic_mic_style()
        self.update_header_buttons_style()
        self.update_theme_styles()
        self.resizeEvent(None)

    def _submit_chat_command(self):
        text = self.chat_input.text().strip()
        if not text:
            return
        self.chat_input.clear()
        
        self.ui.write_log(f"Tú: {text}")
        self.txt_console.setText(text)
        
        if self.ui.on_text_command:
            self.ui.on_text_command(text)

    def update_dynamic_mic_style(self):
        if not hasattr(self, "btn_dynamic_mic"):
            return
        is_muted = self.ui.muted
        if HAS_QTA:
            icon_name = "fa5s.microphone-slash" if is_muted else "fa5s.microphone"
            icon_color = "#ff3b30" if is_muted else C_PRI
            self.btn_dynamic_mic.setIcon(qta.icon(icon_name, color=icon_color))
        else:
            self.btn_dynamic_mic.setText("Mic" if not is_muted else "Mute")
            
        # Estilo mejorado para el botón de micrófono (sin box-shadow/transform)
        border_color = "rgba(255, 59, 48, 0.8)" if is_muted else f"rgba({QColor(C_PRI).red()}, {QColor(C_PRI).green()}, {QColor(C_PRI).blue()}, 0.8)"
        hover_bg = "rgba(255, 59, 48, 0.3)" if is_muted else f"rgba({QColor(C_PRI).red()}, {QColor(C_PRI).green()}, {QColor(C_PRI).blue()}, 0.3)"
        
        self.btn_dynamic_mic.setStyleSheet(f"""
            QPushButton {{
                background-color: rgba(10, 15, 25, 0.95);
                border: 2px solid {border_color};
                border-radius: 16px;
                padding: 0;
            }}
            QPushButton:hover {{
                background-color: {hover_bg};
                border: 2px solid {border_color};
            }}
        """)
        self.btn_dynamic_mic.style().unpolish(self.btn_dynamic_mic)
        self.btn_dynamic_mic.style().polish(self.btn_dynamic_mic)
        self.btn_dynamic_mic.update()

    def update_header_buttons_style(self):
        """Actualiza el estilo de los botones del header con efectos de brillo"""
        # Botón de ajustes
        self.btn_settings.setStyleSheet(f"""
            QPushButton {{
                background-color: rgba(10, 15, 25, 0.95);
                border: 1.5px solid {C_PRI};
                border-radius: 14px;
                padding: 0;
            }}
            QPushButton:hover {{
                background-color: rgba({QColor(C_PRI).red()}, {QColor(C_PRI).green()}, {QColor(C_PRI).blue()}, 0.2);
                border: 1.5px solid {C_PRI};
            }}
        """)
        
        # Botón de minimizar
        self.btn_min.setStyleSheet(f"""
            QPushButton {{
                background-color: rgba(10, 15, 25, 0.95);
                border: 1.5px solid {C_PRI_DIM};
                border-radius: 14px;
                padding: 0;
            }}
            QPushButton:hover {{
                background-color: rgba(180, 180, 180, 0.2);
                border: 1.5px solid {C_PRI_DIM};
            }}
        """)
        
        # Botón de cerrar
        self.btn_close.setStyleSheet(f"""
            QPushButton {{
                background-color: rgba(10, 15, 25, 0.95);
                border: 1.5px solid #ef4444;
                border-radius: 14px;
                padding: 0;
            }}
            QPushButton:hover {{
                background-color: rgba(239, 68, 68, 0.2);
                border: 1.5px solid #ef4444;
            }}
        """)
        
        # Botón de suspender (estilo dinámico)
        self.update_suspend_button_style()
        
        # Botones normales
        normal_buttons = [self.btn_edit_hud, self.btn_camera, self.btn_play, self.btn_folder]
        for btn in normal_buttons:
            btn.setStyleSheet(f"""
                QPushButton {{
                    background-color: rgba(10, 15, 25, 0.95);
                    border: 1px solid rgba(120, 53, 15, 0.5);
                    border-radius: 14px;
                    padding: 0;
                }}
                QPushButton:hover {{
                    background-color: rgba(245, 158, 11, 0.2);
                    border: 1px solid {C_PRI};
                }}
            """)

    def update_suspend_button_style(self):
        """Actualiza el estilo visual del botón de suspender"""
        if not hasattr(self, "btn_suspend"):
            return
        
        is_sleeping = hasattr(self.ui, 'is_sleeping') and self.ui.is_sleeping
        
        if is_sleeping:
            # Modo despierto (botón muestra luna para suspender)
            border_color = C_PRI
            if HAS_QTA:
                self.btn_suspend.setIcon(qta.icon('fa5s.moon', color=C_PRI))
            self.btn_suspend.setToolTip("Suspender ILUM")
        else:
            # Modo suspendido (botón muestra sol para despertar)
            border_color = "#f59e0b"
            if HAS_QTA:
                self.btn_suspend.setIcon(qta.icon('fa5s.sun', color="#f59e0b"))
            self.btn_suspend.setToolTip("Despertar ILUM")
        
        self.btn_suspend.setStyleSheet(f"""
            QPushButton {{
                background-color: rgba(10, 15, 25, 0.95);
                border: 2px solid {border_color};
                border-radius: 14px;
                padding: 0;
            }}
            QPushButton:hover {{
                background-color: rgba({QColor(border_color).red() if border_color != C_PRI else QColor(C_PRI).red()}, 
                                     {QColor(border_color).green() if border_color != C_PRI else QColor(C_PRI).green()}, 
                                     {QColor(border_color).blue() if border_color != C_PRI else QColor(C_PRI).blue()}, 0.2);
                border: 2px solid {border_color};
            }}
        """)

    def update_theme_styles(self):
        # Load advanced dynamic configuration settings
        try:
            from memory.config_manager import load_api_keys
            cfg = load_api_keys()
            
            # Apply dynamic individual color overrides and base themes globally
            theme_val = cfg.get("ilum_theme", "gold")
            custom_hex_val = cfg.get("ilum_custom_theme_color", "")
            apply_theme_tokens(theme_val, custom_hex_val)
            
            # Global Font Family propagation
            font_family = cfg.get("ilum_font_family", "Century Gothic")
            global FONT_FAMILY
            FONT_FAMILY = font_family
            from PyQt6.QtWidgets import QApplication
            QApplication.instance().setFont(QFont(FONT_FAMILY))
            
            # Dynamically update brand label font family and text
            brand_font = QFont(FONT_FAMILY, 16, QFont.Weight.Bold)
            brand_font.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 8.0)
            self.lbl_brand.setFont(brand_font)
            ai_name = cfg.get("ai_name", "").strip().upper()
            if not ai_name:
                ai_name = "I.L.U.M."
            elif len(ai_name) > 1 and " " not in ai_name:
                ai_name = " ".join(list(ai_name))
            self.lbl_brand.setText(ai_name)
            
            # Update Personality Badge
            if hasattr(self, "lbl_personality_badge"):
                try:
                    import json
                    from memory.config_manager import BASE_DIR
                    pers_path = BASE_DIR / "config" / "personalities.json"
                    pers_name = "ILUM"
                    if pers_path.exists():
                        pers_data = json.loads(pers_path.read_text(encoding="utf-8"))
                        active = pers_data.get("active", "actual")
                        pers_dict = pers_data.get("personalities", {})
                        if active in pers_dict:
                            pers_name = pers_dict[active].get("name", "ILUM").upper()
                    self.lbl_personality_badge.setText(f"[ {pers_name} ]")
                    self.lbl_personality_badge.setStyleSheet(f"""
                        background-color: rgba({QColor(C_PRI).red()}, {QColor(C_PRI).green()}, {QColor(C_PRI).blue()}, 0.08);
                        color: {C_PRI};
                        border: 1px solid rgba({QColor(C_PRI).red()}, {QColor(C_PRI).green()}, {QColor(C_PRI).blue()}, 0.3);
                        border-radius: 4px;
                        padding: 3px 8px;
                        font-size: 9px;
                        font-weight: bold;
                        letter-spacing: 1.5px;
                        margin-left: 10px;
                    """)
                except Exception:
                    pass
            
            # Background Image Setup
            bg_image_path = cfg.get("ilum_bg_image", "")
            bg_opacity = float(cfg.get("ilum_bg_opacity", 0.85))
            
            self._bg_image_path = bg_image_path
            self._bg_opacity = bg_opacity
            
            if bg_image_path and Path(bg_image_path).exists():
                from PyQt6.QtGui import QPixmap
                from PyQt6.QtWidgets import QGraphicsOpacityEffect
                pix = QPixmap(bg_image_path)
                if not pix.isNull():
                    self.lbl_bg_image.setPixmap(pix)
                    self.lbl_bg_image.show()
                    
                    opacity_effect = QGraphicsOpacityEffect(self)
                    opacity_effect.setOpacity(bg_opacity)
                    self.lbl_bg_image.setGraphicsEffect(opacity_effect)
                else:
                    self.lbl_bg_image.clear()
                    self.lbl_bg_image.hide()
            else:
                self.lbl_bg_image.clear()
                self.lbl_bg_image.hide()
                self._bg_image_path = ""
                
            # Sticker Image Setup
            sticker_path = cfg.get("ilum_sticker_path", "")
            self._sticker_w = int(cfg.get("ilum_sticker_w", 100))
            self._sticker_h = int(cfg.get("ilum_sticker_h", 100))
            self._sticker_x_pct = int(cfg.get("ilum_sticker_x", 50))
            self._sticker_y_pct = int(cfg.get("ilum_sticker_y", 50))
            
            self._sticker_path = sticker_path
            
            if sticker_path and Path(sticker_path).exists():
                from PyQt6.QtGui import QPixmap
                pix_sticker = QPixmap(sticker_path)
                if not pix_sticker.isNull():
                    scaled_pix = pix_sticker.scaled(
                        self._sticker_w, 
                        self._sticker_h, 
                        Qt.AspectRatioMode.IgnoreAspectRatio, 
                        Qt.TransformationMode.SmoothTransformation
                    )
                    self.lbl_sticker.setPixmap(scaled_pix)
                    self.lbl_sticker.setFixedSize(self._sticker_w, self._sticker_h)
                    self.lbl_sticker.show()
                    self.lbl_sticker.raise_()
                else:
                    self.lbl_sticker.clear()
                    self.lbl_sticker.hide()
            else:
                self.lbl_sticker.clear()
                self.lbl_sticker.hide()
                self._sticker_path = ""
        except Exception as e:
            print(f"Error loading advanced styling configurations: {e}")

        # Choose the dynamic background style for the centralWidget
        if hasattr(self, "_bg_image_path") and self._bg_image_path:
            bg_style = "background-color: rgba(10, 15, 25, 0.40);"
        else:
            bg_color = QColor(C_BG)
            if bg_color.isValid():
                r, g, b = bg_color.red(), bg_color.green(), bg_color.blue()
                bg_style = f"background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba({r}, {g}, {b}, 0.85), stop:1 rgba({max(0, r-15)}, {max(0, g-15)}, {max(0, b-15)}, 0.95));"
            else:
                bg_style = f"background-color: {C_BG};"

        self.central_widget.setStyleSheet(f"""
            QWidget#centralWidget {{
                {bg_style}
                border: 2.2px solid {C_PRI};
                border-radius: 20px;
            }}
        """)
        self.lbl_brand.setStyleSheet(f"color: {C_PRI}; font-weight: bold; background: transparent;")
        
        # Actualizar iconos de los botones
        for btn, icon, cb in self.head_buttons:
            if HAS_QTA:
                if btn == self.btn_close:
                    btn.setIcon(qta.icon(icon, color="#ef4444"))
                elif btn == self.btn_suspend:
                    pass  # Se actualiza en update_suspend_button_style
                elif btn == self.btn_min:
                    btn.setIcon(qta.icon(icon, color=C_PRI_DIM))
                else:
                    btn.setIcon(qta.icon(icon, color=C_PRI_DIM))
        
        # Actualizar estilos de los botones del header
        self.update_header_buttons_style()
            
        self.txt_console.setStyleSheet(f"QLabel {{ color: {C_PRI}; font-weight: bold; font-size: 16px; background: rgba(0,0,0,0.4); border-radius: 8px; padding: 10px; }}")
        
        if hasattr(self, "chat_input"):
            self.chat_input.setStyleSheet(f"""
                QLineEdit#chatInput {{
                    background: rgba(0, 0, 0, 0.65);
                    color: white;
                    border: 1.2px solid {C_BORDER};
                    border-radius: 15px;
                    padding: 0px 15px;
                    font-size: 12px;
                }}
                QLineEdit#chatInput:focus {{
                    border: 1.5px solid {C_PRI};
                }}
            """)
            
        self.spotify_w.update_style()
        self.system_w.update_style()
        self.todo_w.update_style()
        self.notes_w.update_style()
        self.files_panel.update_style()
        self.clock_w.update_style()
        self.weather_w.update_style()
        
        if hasattr(self, "orb"):
            self.orb.sync_theme()
            
        if hasattr(self, "btn_dynamic_mic"):
            self.update_dynamic_mic_style()

    def resizeEvent(self, event):
        if event is not None:
            super().resizeEvent(event)
        W = self.central_widget.width()
        H = self.central_widget.height()
        
        # Round the window mask cleanly to avoid sharp corners from children desbordamiento
        path = QPainterPath()
        path.addRoundedRect(QRectF(0, 0, W, H), 20.0, 20.0)
        self.setMask(QRegion(path.toFillPolygon().toPolygon()))
        
        # Resize background image label to full window and scale pixmap
        if hasattr(self, "lbl_bg_image") and self.lbl_bg_image.isVisible() and hasattr(self, "_bg_image_path") and self._bg_image_path:
            self.lbl_bg_image.setGeometry(0, 0, W, H)
            if Path(self._bg_image_path).exists():
                from PyQt6.QtGui import QPixmap
                pix = QPixmap(self._bg_image_path)
                if not pix.isNull():
                    scaled_pix = pix.scaled(
                        W, H, 
                        Qt.AspectRatioMode.KeepAspectRatioByExpanding, 
                        Qt.TransformationMode.SmoothTransformation
                    )
                    self.lbl_bg_image.setPixmap(scaled_pix)
            self.lbl_bg_image.lower()
            
        self.header_container.setGeometry(0, 0, W, 45)
        
        self.clock_w.setGeometry(W - 260, 50, 240, 70)
        
        self.orb.setGeometry(0, 45, W, H - 45)
        
        # Calculate dynamic widgets height based on whether it is hidden or not
        widgets_h = 0
        if hasattr(self, "widget_bar_container") and not self.widget_bar_container.isHidden():
            widgets_h = 40
            
        # Position centered continuous speech line at bottom of HUD
        if hasattr(self, "widget_bar_container"):
            self.widget_bar_container.setGeometry(100, H - 50, W - 200, 32)
            
        if widgets_h > 0:
            self.txt_console.setGeometry(30, H - 180, W - 60, 120)
        else:
            self.txt_console.setGeometry(30, H - 180, W - 60, 120)
            
        # Stacking order management
        if hasattr(self, "lbl_bg_image"):
            self.lbl_bg_image.lower()
            
        # Raise individual widgets instead of container
        for w in [getattr(self, "spotify_w", None), getattr(self, "weather_w", None), getattr(self, "system_w", None), 
                  getattr(self, "todo_w", None), getattr(self, "notes_w", None), getattr(self, "files_panel", None)]:
            if w: w.raise_()
        if hasattr(self, "widget_bar_container"):
            self.widget_bar_container.raise_()
        self.txt_console.raise_()
        self.clock_w.raise_()
        if hasattr(self, "header_container"):
            self.header_container.raise_()
        
        # Position and scale sticker label dynamically if active
        if hasattr(self, "lbl_sticker") and self.lbl_sticker.isVisible() and hasattr(self, "_sticker_path") and self._sticker_path:
            x = int((W - self._sticker_w) * (self._sticker_x_pct / 100.0))
            y = int((H - self._sticker_h) * (self._sticker_y_pct / 100.0))
            self.lbl_sticker.setGeometry(x, y, self._sticker_w, self._sticker_h)
            self.lbl_sticker.raise_()

    def _open_settings(self):
        dialog = DeviceSettingsDialog(self)
        self._active_settings_dialog = dialog
        if dialog.exec() == QDialog.DialogCode.Accepted:
            if self.ui.on_config_saved:
                from memory.config_manager import load_api_keys
                self.ui.on_config_saved(load_api_keys())
        self._active_settings_dialog = None
        dialog.deleteLater()

    def update_macros_list_if_open(self):
        if hasattr(self, "_active_settings_dialog") and self._active_settings_dialog:
            self._active_settings_dialog.load_macros()
        if hasattr(self, "files_panel"):
            self.files_panel.load_macros()

    def _open_folder(self):
        try:
            ruta_descargas = os.path.join(os.path.expanduser("~"), "Downloads", "Ilum_Downloads")
            os.makedirs(ruta_descargas, exist_ok=True)
            os.startfile(ruta_descargas)
        except Exception:
            pass
            
    def _open_diagnostic_logs(self):
        dialog = LogsDialog(self)
        dialog.exec()
            
    def _toggle_mute(self):
        if self.ui.on_stop_command:
            self.ui.on_stop_command()
        if self.ui.on_text_command:
            self.ui.on_text_command("SYS_TOGGLE_SUSPEND")

    def _toggle_suspend(self):
        if self.ui.on_text_command:
            self.ui.on_text_command("SYS_TOGGLE_SUSPEND")

    def update_suspend_button(self, is_sleeping: bool):
        self.ui.is_sleeping = is_sleeping
        self.update_suspend_button_style()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_Escape:
            if self.ui.on_stop_command:
                self.ui.on_stop_command()
            event.accept()
        else:
            super().keyPressEvent(event)

    def _toggle_camera_gestures(self):
        """Toggle camera gesture preview."""
        from PyQt6.QtWidgets import QMessageBox

        if not hasattr(self, '_gesture_thread') or self._gesture_thread is None:
            try:
                import mediapipe
            except ImportError:
                IlumMessageBox(
                    self, 
                    "Piloto Gestual Desactivado", 
                    "El módulo 'mediapipe' no está instalado en este equipo.\n\n"
                    "Para habilitar el control gestual por cámara, por favor instala "
                    "Python 3.12 y ejecuta el instalador nuevamente.", 
                    is_error=True
                ).exec()
                return

            try:
                from actions.gesture_engine import GestureTrackingThread
                camera_index = 0
                try:
                    from memory.config_manager import load_api_keys
                    cfg = load_api_keys()
                    camera_index = int(cfg.get("camera_device", 0))
                except Exception:
                    camera_index = 0

                self._gesture_thread = GestureTrackingThread(
                    camera_index=camera_index,
                    theme_bgr=hex_to_bgr(C_PRI),
                    text_bgr=hex_to_bgr(C_TEXT)
                )
                self._gesture_thread.start()
                print("[UI] Gesture tracking thread started.")
            except Exception as e:
                IlumMessageBox(self, "Error", f"Fallo al iniciar la cámara gestual:\n{e}", is_error=True).exec()
                return

        if self.camera_window is None:
            self.camera_window = CameraPreviewWindow(shared_thread=self._gesture_thread, parent=None)
            self.camera_window.attach_thread(self._gesture_thread)
            self.camera_window.show()
            self.camera_window.move(50, 50)
        else:
            if self.camera_window.isVisible():
                self.camera_window.hide()
            else:
                self.camera_window.show()
                self.camera_window.raise_()

    def stop_gesture_thread(self):
        if hasattr(self, '_gesture_thread') and self._gesture_thread is not None:
            self._gesture_thread.stop()
            self._gesture_thread = None

    def _setup_tray_icon(self):
        from PyQt6.QtWidgets import QSystemTrayIcon, QMenu
        self.tray_icon = QSystemTrayIcon(self)
        icon_path = get_bundled_path("assets", "ilum_icono.ico")
        if icon_path.exists():
            self.tray_icon.setIcon(QIcon(str(icon_path)))
        else:
            from PyQt6.QtWidgets import QStyle
            self.tray_icon.setIcon(self.style().standardIcon(QStyle.StandardPixmap.SP_ComputerIcon))
            
        tray_menu = QMenu(self)
        
        show_action = tray_menu.addAction("Mostrar ILUM")
        show_action.triggered.connect(self.show_and_activate)
        
        mute_action = tray_menu.addAction("Silenciar/Escuchar")
        mute_action.triggered.connect(self._toggle_mute)
        
        suspend_action = tray_menu.addAction("Suspender / Despertar")
        suspend_action.triggered.connect(self._toggle_suspend)
        
        tray_menu.addSeparator()
        
        exit_action = tray_menu.addAction("Salir")
        exit_action.triggered.connect(self._exit_application)
        
        self.tray_icon.setContextMenu(tray_menu)
        self.tray_icon.activated.connect(self._on_tray_activated)
        self.tray_icon.show()

    def show_and_activate(self):
        self.showNormal()
        self.activateWindow()
        self.raise_()

    def _exit_application(self):
        self._force_close = True
        self.close()
        try:
            self.stop_gesture_thread()
        except Exception:
            pass
        try:
            from PyQt6.QtWidgets import QApplication
            QApplication.quit()
        except Exception:
            pass
        import os
        os._exit(0)

    def _handle_shutdown(self):
        self._exit_application()

    def _on_tray_activated(self, reason):
        from PyQt6.QtWidgets import QSystemTrayIcon
        if reason in (QSystemTrayIcon.ActivationReason.DoubleClick, QSystemTrayIcon.ActivationReason.Trigger):
            if self.isVisible():
                self.hide()
            else:
                self.show_and_activate()

    def closeEvent(self, event):
        if getattr(self, "_force_close", False):
            self.stop_gesture_thread()
            event.accept()
        else:
            event.ignore()
            self.hide()
            if hasattr(self, "tray_icon") and self.tray_icon.isVisible():
                from PyQt6.QtWidgets import QSystemTrayIcon
                self.tray_icon.showMessage(
                    "ILUM AI",
                    "Sigo activo en segundo plano. Presiona Insert para hablar o haz doble clic aquí para mostrarme.",
                    QSystemTrayIcon.MessageIcon.Information,
                    3000
                )

    def mousePressEvent(self, event: QMouseEvent):
        if event.button() == Qt.MouseButton.LeftButton:
            self._drag_pos = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
            event.accept()

    def mouseMoveEvent(self, event: QMouseEvent):
        if self._drag_pos and event.buttons() == Qt.MouseButton.LeftButton:
            self.move(event.globalPosition().toPoint() - self._drag_pos)
            event.accept()

    def mouseReleaseEvent(self, event: QMouseEvent):
        if event.button() == Qt.MouseButton.LeftButton:
            self._drag_pos = None
            try:
                from memory.config_manager import load_api_keys, save_api_keys
                cfg = load_api_keys()
                pos = self.frameGeometry().topLeft()
                cfg["window_x"] = pos.x()
                cfg["window_y"] = pos.y()
                save_api_keys(cfg)
            except Exception:
                pass
        event.accept()

    @pyqtSlot()
    def toggle_hud_edit_mode(self):
        if not hasattr(self, "hud_edit_mode"):
            self.hud_edit_mode = False
            self.drag_filter = WidgetDragFilter(self)
            
        self.hud_edit_mode = not self.hud_edit_mode
        widgets = [self.spotify_w, self.weather_w, self.system_w, self.todo_w, self.notes_w, self.files_panel]
        
        key_map = {
            "SpotifyWidget": "show_widget_spotify",
            "WeatherWidget": "show_widget_weather",
            "SystemWidget": "show_widget_system",
            "TodoWidget": "show_widget_todo",
            "NotesWidget": "show_widget_notes",
            "FilesPanel": "show_widget_files"
        }
        
        for w in widgets:
            if self.hud_edit_mode:
                w.installEventFilter(self.drag_filter)
                w._resize_filter = WidgetResizeFilter(w)
                w.installEventFilter(w._resize_filter)
                
                for pos in ["TL", "TR", "BL", "BR"]:
                    h = ResizeHandle(w, pos)
                    if pos == "TL": h.move(0, 0)
                    elif pos == "TR": h.move(w.width() - 14, 0)
                    elif pos == "BL": h.move(0, w.height() - 14)
                    elif pos == "BR": h.move(w.width() - 14, w.height() - 14)
                    h.show()
                
                w.setStyleSheet(f"QWidget#{w.objectName()} {{ border: 2px dashed #f59e0b; background: rgba(245, 158, 11, 0.1); }}")
                del_btn = QPushButton("✕", w)
                del_btn.setObjectName("EditModeDelBtn")
                del_btn.setFixedSize(24, 24)
                del_btn.setStyleSheet("background: #ef4444; color: white; border-radius: 12px; font-weight: bold; border: none; font-size: 12px;")
                
                def remove_widget(checked=False, widget=w):
                    widget.hide()
                    try:
                        from memory.config_manager import load_api_keys, save_api_keys
                        cfg = load_api_keys()
                        key = key_map.get(widget.__class__.__name__)
                        if key:
                            cfg[key] = False
                            save_api_keys(cfg)
                    except Exception:
                        pass
                del_btn.clicked.connect(remove_widget)
                del_btn.move(w.width() - 30, 15)
                del_btn.show()
            else:
                w.removeEventFilter(self.drag_filter)
                if hasattr(w, "_resize_filter"):
                    w.removeEventFilter(w._resize_filter)
                w.update_style()
                for child in w.children():
                    if child.objectName() == "EditModeDelBtn" or isinstance(child, ResizeHandle):
                        child.deleteLater()
                
                try:
                    from memory.config_manager import load_api_keys, save_api_keys
                    cfg = load_api_keys()
                    w_name = w.__class__.__name__
                    cfg[f"widget_pos_{w_name}_x"] = w.x()
                    cfg[f"widget_pos_{w_name}_y"] = w.y()
                    cfg[f"widget_size_{w_name}_w"] = w.width()
                    cfg[f"widget_size_{w_name}_h"] = w.height()
                    save_api_keys(cfg)
                except Exception:
                    pass
                
        if self.hud_edit_mode:
            IlumMessageBox(self, "INFO", "Modo edición HUD activado. Arrastre los widgets para reposicionarlos.").exec()
        else:
            IlumMessageBox(self, "INFO", "Modo edición HUD desactivado. Posiciones guardadas.").exec()

    @pyqtSlot()
    def open_student_mode(self):
        self.ui.open_student_mode()

    @pyqtSlot(str, dict)
    def handle_student_action(self, action_name, data):
        self.ui.open_student_mode()
        win = getattr(self.ui, "student_window", None)
        if not win:
            return
            
        if "status" in data:
            win.global_status_label.setText(data["status"])
        if "progress" in data:
            win.global_progress_bar.setValue(int(data["progress"]))
            
        if action_name == "paraphrase":
            win.tabs.setCurrentIndex(0)
            win.ghost_input.setPlainText(data.get("input", ""))
            win.ghost_output.setPlainText(data.get("output", ""))
            win.global_status_label.setText("Estado: Parafraseo Ghost completado.")
            win.global_progress_bar.setValue(100)
        elif action_name == "pdf":
            win.tabs.setCurrentIndex(1)
            pdf_path = data.get("pdf_path", "")
            status = data.get("status", "")
            win.pdf_file_label.setText(f"Archivo: {pdf_path}")
            win.pdf_status_label.setText(status)
            if data.get("progress") is not None:
                win.pdf_progress.setValue(int(data.get("progress")))
                win.global_progress_bar.setValue(int(data.get("progress")))
            win.global_status_label.setText(f"Estado PDF: {status}")
        elif action_name == "apa":
            win.tabs.setCurrentIndex(2)
            if data.get("input"):
                win.apa_input_text.setPlainText(data.get("input"))
            if data.get("output"):
                win.apa_output.setPlainText(data.get("output"))
            win.global_status_label.setText("Estado: Verificación APA 7 completada.")
            win.global_progress_bar.setValue(100)
        elif action_name == "quality":
            win.tabs.setCurrentIndex(4)
            win.quality_file_label.setText(f"Archivo: {data.get('file_path', '')}")
            win.quality_output.setHtml(data.get("report_html", ""))


class MockRoot:
    def __init__(self, qapp: QApplication):
        self.qapp = qapp
        
    def mainloop(self):
        sys.exit(self.qapp.exec())
        
    def after(self, ms: int, func):
        QTimer.singleShot(ms, func)


class IlumUI:
    def __init__(self, face_path=""):
        self.app = QApplication.instance() or QApplication(sys.argv)
        self.app.setQuitOnLastWindowClosed(False)
        self.root = MockRoot(self.app)
        
        self.muted = False
        self.current_file = ""
        
        self.on_text_command = None
        self.on_stop_command = None
        self.on_config_saved = None
        
        self.ilum_response_buffer = ""
        
        self._win = MainWindow(self, face_path)
        self._win.show()
        self._win.raise_()
        self._win.activateWindow()
        from ui_glass_overlay import apply_liquid_glass
        apply_liquid_glass(self._win)
        
        # Ensure startup shortcut is set up after 2 seconds (so it doesn't block startup)
        QTimer.singleShot(2000, self.ensure_startup_shortcut)
        
    def wait_for_api_key(self):
        pass

    def update_suspend_button(self, is_sleeping: bool):
        if self._win:
            QTimer.singleShot(0, lambda: self._win.update_suspend_button(is_sleeping))

    def write_log(self, text: str):
        print(text)
        from PyQt6.QtCore import QTimer
        def _update():
            if text.startswith("SYS:") or text.startswith("ERR:") or text.startswith("⚡"):
                self.ilum_response_buffer = ""
                self._win.txt_console.setText(text)
            elif text.startswith("Tú:"):
                self.last_user_message = text
                disp_text = self.last_user_message
                if getattr(self, "ilum_response_buffer", ""):
                    disp_text += f"\nILUM: {self.ilum_response_buffer}"
                self._win.txt_console.setText(disp_text)
            elif text.startswith("ILUM:"):
                clean = text.replace("ILUM:", "").strip()
                if clean:
                    self.ilum_response_buffer = clean
                    disp_text = f"ILUM: {self.ilum_response_buffer}"
                    if getattr(self, "last_user_message", ""):
                        disp_text = f"{self.last_user_message}\n{disp_text}"
                    self._win.txt_console.setText(disp_text)
            else:
                self._win.txt_console.setText(text)
        QTimer.singleShot(0, _update)

    def set_state(self, state: str):
        # Update muted state synchronously to avoid race conditions across threads
        if state == "MUTED":
            self.muted = True
        elif state == "LISTENING":
            self.muted = False

        from PyQt6.QtCore import QTimer
        def _do_set():
            if state == "MUTED":
                self._win.orb.set_state("MUTED")
            else:
                if self.muted:
                    self._win.orb.set_state("MUTED")
                else:
                    self._win.orb.set_state(state)
            if hasattr(self._win, "update_dynamic_mic_style"):
                self._win.update_dynamic_mic_style()
        QTimer.singleShot(0, _do_set)
                
    def set_audio_level(self, level: float):
        self._win.orb.set_audio(level)
        
    def clear_ilum_response(self):
        from PyQt6.QtCore import QTimer
        def _do_clear():
            self.ilum_response_buffer = ""
            if getattr(self, "last_user_message", ""):
                self._win.txt_console.setText(self.last_user_message)
            else:
                self._win.txt_console.setText("")
        QTimer.singleShot(0, _do_clear)
        
    def stream_ilum_chunk(self, chunk: str):
        from PyQt6.QtCore import QTimer
        def _do_stream():
            text = chunk.replace("ILUM:", "").strip()
            if text:
                if getattr(self, "ilum_response_buffer", ""):
                    self.ilum_response_buffer += " " + text
                else:
                    self.ilum_response_buffer = text
                
                disp_text = f"ILUM: {self.ilum_response_buffer}"
                if getattr(self, "last_user_message", ""):
                    disp_text = f"{self.last_user_message}\n{disp_text}"
                self._win.txt_console.setText(disp_text)
        QTimer.singleShot(0, _do_stream)

    def open_student_mode(self):
        if not hasattr(self, "student_window") or self.student_window is None:
            self.student_window = StudentModeWindow(self._win)
        if self.student_window.isHidden():
            self.student_window.show()
        self.student_window.raise_()
        self.student_window.activateWindow()

    def ensure_startup_shortcut(self):
        try:
            import os
            import subprocess
            appdata = os.getenv('APPDATA')
            if not appdata:
                return
            startup_dir = os.path.join(appdata, 'Microsoft', 'Windows', 'Start Menu', 'Programs', 'Startup')
            shortcut_path = os.path.join(startup_dir, 'ILUM AI.lnk')
            
            current_dir = os.path.abspath(os.path.dirname(__file__))
            target_vbs = os.path.join(current_dir, "Iniciar ILUM Beta.vbs")
            icon_path = os.path.join(current_dir, "assets", "ilum_icono.ico")
            
            if not os.path.exists(target_vbs):
                return
                
            ps_cmd = (
                f"$s=(New-Object -ComObject WScript.Shell).CreateShortcut('{shortcut_path}');"
                f"$s.TargetPath='{target_vbs}';"
                f"$s.WorkingDirectory='{current_dir}';"
                f"$s.IconLocation='{icon_path}';"
                f"$s.Description='Lanzador Automatico de ILUM AI (Admin)';"
                f"$s.Save()"
            )
            subprocess.run(["powershell", "-NoProfile", "-Command", ps_cmd], check=True, creationflags=subprocess.CREATE_NO_WINDOW)
            print("[STARTUP] Startup shortcut ensured successfully.")
        except Exception as e:
            print(f"[STARTUP] Error ensuring startup shortcut: {e}")


