        sep_inst = QFrame()
        sep_inst.setFrameShape(QFrame.Shape.HLine)
        sep_inst.setFrameShadow(QFrame.Shadow.Sunken)
        local_lay.addWidget(sep_inst)

        # Recommended Models Section
        rec_hdr = QLabel("MODELOS LOCALES RECOMENDADOS")
        rec_hdr.setStyleSheet(f"color: {C_PRI}; font-size: 11px; font-weight: bold; letter-spacing: 2px; margin-top: 5px;")
        local_lay.addWidget(rec_hdr)

        # We add the models directly into local_lay to prevent nested QScrollArea collapse and text overlapping.

        self.recommended_models = [
            ("gemma2:2b", "GEMMA 2 2B (1.6 GB)", "Excelente para español, rápido y ligero. Óptimo para PCs sencillas."),
            ("llama3.2-vision:11b", "LLAMA 3.2 VISION (7.9 GB)", "Excelente para analizar tu pantalla localmente. Requiere buena PC."),
            ("llava:7b", "LLAVA 7B (4.7 GB)", "Modelo multimodal rápido, soporta análisis de imágenes y pantalla."),
            ("llama3:latest", "LLAMA 3 8B (4.7 GB)", "Meta AI potente y de propósito general. Requiere GPU o buena RAM."),
            ("deepseek-r1:1.5b", "DEEPSEEK R1 1.5B (900 MB)", "Razonamiento lógico avanzado y ultra-ligero."),
            ("deepseek-r1:8b", "DEEPSEEK R1 8B (4.7 GB)", "Razonamiento matemático y análisis lógico profundo de alto nivel.")
        ]

        self.model_cards = {}
        for code, name, desc in self.recommended_models:
            card = QFrame()
            card.setMinimumHeight(100)
            card.setStyleSheet("""
                QFrame {
                    background-color: rgba(255, 255, 255, 0.06);
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    border-radius: 6px;
                }
            """)
            card_lay = QVBoxLayout(card)
            card_lay.setContentsMargins(8, 8, 8, 8)
            card_lay.setSpacing(4)

            # Name and status header
            hdr_lay = QHBoxLayout()
            lbl_name = QLabel(name)
            lbl_name.setMinimumWidth(10)
            lbl_name.setStyleSheet("color: white; font-weight: bold; font-size: 11px; background: transparent; border: none;")
            hdr_lay.addWidget(lbl_name)
            hdr_lay.addStretch()

            lbl_status = QLabel("CONSULTANDO...")
            lbl_status.setMinimumWidth(10)
            lbl_status.setStyleSheet("color: #a1a1aa; font-weight: bold; font-size: 9px; letter-spacing: 1px; background: transparent; border: none;")
            hdr_lay.addWidget(lbl_status)
            card_lay.addLayout(hdr_lay)

            # Description
            lbl_desc = QLabel(desc)
            lbl_desc.setMinimumWidth(10)
            lbl_desc.setWordWrap(True)
