# =====================================================================

class DocumentRenderWorker(QThread):
    progress = pyqtSignal(int)
    status = pyqtSignal(str)
    finished = pyqtSignal(list, str) # list of QImage, error message
    
    def __init__(self, file_path):
        super().__init__()
        self.file_path = file_path
        
    def run(self):
        import os
        import fitz
        from PyQt6.QtGui import QImage
        
        temp_pdf_path = None
        try:
            self.status.emit("Preparando archivo...")
            self.progress.emit(10)
            
            ext = os.path.splitext(self.file_path)[1].lower()
            pdf_file = self.file_path
            
            if ext == ".docx":
                self.status.emit("Convirtiendo Word a PDF usando Office COM...")
                self.progress.emit(25)
                import comtypes.client
                comtypes.CoInitialize()
                try:
                    word = comtypes.client.CreateObject("Word.Application")
                    word.Visible = False
                    doc = word.Documents.Open(os.path.abspath(self.file_path))
                    temp_dir = os.path.dirname(self.file_path)
                    temp_pdf_name = f"temp_rendered_{os.path.basename(self.file_path)}.pdf"
                    temp_pdf_path = os.path.join(temp_dir, temp_pdf_name)
                    doc.SaveAs(os.path.abspath(temp_pdf_path), FileFormat=17)
                    doc.Close()
                    word.Quit()
                    pdf_file = temp_pdf_path
                except Exception as word_err:
                    self.finished.emit([], f"Error al convertir Word a PDF: {word_err}")
                    return
                finally:
                    comtypes.CoUninitialize()
                    
            self.status.emit("Cargando documento y renderizando páginas...")
            self.progress.emit(50)
            doc = fitz.open(pdf_file)
            pages = []
            total_pages = len(doc)
            for i in range(total_pages):
                self.status.emit(f"Renderizando página {i+1} de {total_pages}...")
                page = doc.load_page(i)
                pix = page.get_pixmap(dpi=120)
                # Convert in-memory pixmap to QImage
                qimg = QImage(pix.samples, pix.width, pix.height, pix.stride, QImage.Format.Format_RGB888).copy()
                pages.append(qimg)
                self.progress.emit(50 + int((i+1)/total_pages * 40))
                
            doc.close()
            
            # Clean up temporary PDF if created
            if temp_pdf_path and os.path.exists(temp_pdf_path):
                try:
                    os.remove(temp_pdf_path)
                except:
                    pass
                    
            self.progress.emit(100)
            self.finished.emit(pages, "")
        except Exception as e:
            self.finished.emit([], f"Error al renderizar el documento: {e}")


class PdfToWordWorker(QThread):
    progress = pyqtSignal(int)
    status = pyqtSignal(str)
    finished = pyqtSignal(str)
    
    def __init__(self, pdf_path, docx_path):
        super().__init__()
        self.pdf_path = pdf_path
        self.docx_path = docx_path
        
    def run(self):
        try:
            self.status.emit("Iniciando conversión estructural...")
            self.progress.emit(20)
            from pdf2docx import Converter
            cv = Converter(self.pdf_path)
            self.status.emit("Reconstruyendo tablas, párrafos y columnas...")
            self.progress.emit(50)
            cv.convert(self.docx_path)
            cv.close()
            self.progress.emit(100)
            self.finished.emit(f"Éxito: PDF convertido a Word y guardado en '{self.docx_path}'")
        except Exception as e:
            self.status.emit("Error en pdf2docx. Probando fallback lineal...")
            self.progress.emit(60)
            try:
                from docx import Document
                from actions.student_mode import extract_text
                text = extract_text(self.pdf_path)
                if text.startswith("[Error"):
                    raise Exception(text)
                doc = Document()
                from pathlib import Path
                doc.add_heading(Path(self.pdf_path).stem, 0)
                for p in text.split("\n\n"):
                    if p.strip():
                        doc.add_paragraph(p.strip())
                doc.save(self.docx_path)
                self.progress.emit(100)
                self.finished.emit(f"Conversión completada con fallback lineal. Guardado en '{self.docx_path}'")
            except Exception as e2:
                self.finished.emit(f"Error en la conversión: {e}\nError en fallback: {e2}")


class QualityReportWorker(QThread):
    status = pyqtSignal(str)
    finished = pyqtSignal(str)
    
    def __init__(self, text, filename):
        super().__init__()
        self.text = text
        self.filename = filename
        
    def run(self):
        try:
            self.status.emit("Llamando a Artemisa para evaluación de calidad...")
            from memory.config_manager import load_api_keys
            cfg = load_api_keys()
            api_key = cfg.get("gemini_api_key", "")
            from google import genai
            client = genai.Client(api_key=api_key)
            
            prompt = (
                "Actúa como un revisor académico senior de revistas científicas de alto impacto.\n"
                f"Analiza el siguiente texto extraído del documento '{self.filename}' y genera un REPORTE DE CALIDAD ACADÉMICA formal y estructurado en formato HTML estilizado.\n\n"
                "La respuesta DEBE ser únicamente código HTML (sin bloques de código markdown como ```html o similares) que use etiquetas limpias de estructura. Debe contener los siguientes apartados estructurados de forma atractiva y eficiente:\n"
                "1. Calificación Global (por ejemplo, 85/100) con explicación breve de su rango de calidad (Excelente, Aceptable, Regular o Crítico).\n"
                "2. Fortalezas Clave (3-4 puntos estructurados de forma concisa).\n"
                "3. Puntos de Mejora Prioritarios (3-4 aspectos en orden de importancia).\n"
                "4. Evaluación del Rigor Científico (método, marco conceptual, fuentes bibliográficas).\n"
                "5. Plan de Acción Académico Eficiente (pasos ordenados para optimizar el documento).\n\n"
                "Diseña el HTML de forma sobria y moderna, usando bloques/tarjetas estilizados con fondos oscuros translúcidos, bordes finos de color de acento, fuentes legibles y colores semánticos (verde/cyan para fortalezas, ámbar/rojo para debilidades). No uses estilos externos ni JS complejo. Asegura que sea compatible con QTextEdit de Qt.\n\n"
                f"TEXTO DEL DOCUMENTO A EVALUAR:\n\n{self.text[:9000]}"
            )
            
            resp = client.models.generate_content(
                model="gemini-2.5-flash",
                contents=prompt
            )
            report_html = resp.text.strip()
            if report_html.startswith("```"):
                lines = report_html.split("\n")
                if lines[0].startswith("```"):
                    lines = lines[1:]
                if lines[-1].startswith("```"):
                    lines = lines[:-1]
                report_html = "\n".join(lines).strip()
            self.finished.emit(report_html)
        except Exception as e:
            self.finished.emit(f"<div style='color:#ff3b30;'>Error en la evaluación de calidad: {e}</div>")


class ApaVerifyWorker(QThread):
    status = pyqtSignal(str)
    progress = pyqtSignal(int)
    finished = pyqtSignal(str)
    
    def __init__(self, text, file_path):
        super().__init__()
        self.text = text
        self.file_path = file_path
        
    def run(self):
        try:
            self.status.emit("Iniciando validación...")
            self.progress.emit(10)
            
            formatting_report = ""
            if self.file_path:
                ext = os.path.splitext(self.file_path)[1].lower()
                if ext == ".docx":
                    self.status.emit("Analizando estructura de márgenes, sangrías e interlineado en Word...")
                    from actions.student_mode import check_docx_apa_formatting
                    formatting_report = check_docx_apa_formatting(self.file_path)
                elif ext == ".pdf":
                    formatting_report = (
                        "=== ANÁLISIS ESTRUCTURAL OBJETIVO (Archivo .pdf) ===\n"
                        "[✓] Documento cargado exitosamente en formato PDF.\n"
                        "[✓] Analizando estructura visualmente con Artemisa Multimodal...\n\n"
                    )
            else:
                formatting_report = (
                    "=== AVISO DE FORMATO ESTÁNDAR ===\n"
                    "[!] Has ingresado el texto en formato plano. No es posible analizar objetivamente "
                    "la sangría de primera línea (1.27 cm), márgenes del documento (2.54 cm) ni el interlineado original (2.0) desde el panel de texto plano.\n"
                    "Para una evaluación estructural objetiva y realista de tu documento, por favor carga el archivo original "
                    "en formato Word (.docx) o PDF usando el botón de carga, sir.\n\n"
                )
                
            self.progress.emit(30)
            self.status.emit("Extrayendo imágenes clave para análisis visual...")
            
            pil_images = []
            if self.file_path:
                try:
                    import fitz
                    from PIL import Image
                    
                    pdf_file = self.file_path
                    temp_pdf_path = None
                    ext = os.path.splitext(self.file_path)[1].lower()
                    if ext == ".docx":
                        import comtypes.client
                        comtypes.CoInitialize()
                        try:
                            word = comtypes.client.CreateObject("Word.Application")
                            word.Visible = False
                            doc = word.Documents.Open(os.path.abspath(self.file_path))
                            temp_dir = os.path.dirname(self.file_path)
                            temp_pdf_name = f"temp_apa_{os.path.basename(self.file_path)}.pdf"
                            temp_pdf_path = os.path.join(temp_dir, temp_pdf_name)
                            doc.SaveAs(os.path.abspath(temp_pdf_path), FileFormat=17)
                            doc.Close()
                            word.Quit()
                            pdf_file = temp_pdf_path
                        finally:
                            comtypes.CoUninitialize()
                            
                    doc = fitz.open(pdf_file)
                    if len(doc) > 0:
                        p = doc.load_page(0)
                        pix = p.get_pixmap(dpi=120)
                        pil_images.append(Image.frombytes("RGB", [pix.width, pix.height], pix.samples))
                    if len(doc) > 1:
                        p = doc.load_page(1)
                        pix = p.get_pixmap(dpi=120)
                        pil_images.append(Image.frombytes("RGB", [pix.width, pix.height], pix.samples))
                    doc.close()
                    
                    if temp_pdf_path and os.path.exists(temp_pdf_path):
                        try:
                            os.remove(temp_pdf_path)
                        except:
                            pass
                except Exception as img_err:
                    print(f"Error loading PIL images for Gemini multimodal: {img_err}")
            
            self.status.emit("Llamando a Artemisa Multimodal...")
            self.progress.emit(65)
            
            from memory.config_manager import load_api_keys
            cfg = load_api_keys()
            api_key = cfg.get("gemini_api_key", "")
            
            from google import genai
            client = genai.Client(api_key=api_key)
            
            prompt = (
                "Actúa como un experto en redacción científica y normas de publicación internacional.\n"
                "Analiza el siguiente texto académico y formatea/corrige todo estrictamente bajo las Normas APA 7ma Edición (citas, bibliografía, referencias, redacción científica).\n"
                "Si hay imágenes de páginas del documento adjuntas, ANALÍZALAS VISUALMENTE para comprobar el diseño estético de alta fidelidad:\n"
                "- Verifica los márgenes (deben ser de 2.54 cm / 1 pulgada en todos los lados).\n"
                "- Verifica si la sangría de primera línea está aplicada visualmente (1.27 cm / 0.5 pulgadas) en los párrafos de cuerpo.\n"
                "- Revisa si la Portada (título en negrita, centrado, datos institucionales, etc.) está correctamente estructurada según APA 7 (primera hoja).\n"
                "- Verifica si los números de página aparecen en la esquina superior derecha del encabezado.\n"
                "- Verifica que el interlineado sea doble (2.0).\n\n"
                "Devuelve un reporte sumamente estructurado con:\n"
                "1. EVALUACIÓN Y ANÁLISIS DE DISEÑO VISUAL (sé sumamente detallado, específico y constructivo sobre los márgenes, sangrías y portada observados en las fotos).\n"
                "2. CORRECCIONES DE CITAS Y TEXTO (muestra los textos originales vs corregidos y su justificación).\n"
                "3. RECOMENDACIONES FINALES DE ESTRUCTURACIÓN ACADÉMICA.\n\n"
                f"TEXTO DEL DOCUMENTO:\n\n{self.text}"
            )
            
            contents = [prompt]
            contents.extend(pil_images)
            
            resp = client.models.generate_content(
                model="gemini-2.5-flash",
                contents=contents
            )
            verified = resp.text.strip()
            
            combined_result = formatting_report + "\n" + verified
            self.progress.emit(100)
            self.finished.emit(combined_result)
        except Exception as e:
            self.finished.emit(f"Error: {e}")


class StudentModeWindow(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("ILUM-IA - Herramientas Académicas y Modo Estudiante")
        self.resize(850, 600)
        self.setMinimumSize(800, 550)
        
        # UI Premium: Sin bordes
        self.setWindowFlags(Qt.WindowType.Dialog | Qt.WindowType.FramelessWindowHint)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        
        self.loaded_quality_text = ""
        self.loaded_quality_file = ""
        self.loaded_apa_file = ""
        
        self.drag_pos = None
        
        self.init_ui()

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.drag_pos = event.globalPosition().toPoint()
            
    def mouseMoveEvent(self, event):
        if self.drag_pos is not None:
            self.move(self.pos() + event.globalPosition().toPoint() - self.drag_pos)
            self.drag_pos = event.globalPosition().toPoint()
            
    def mouseReleaseEvent(self, event):
        self.drag_pos = None
        
    def init_ui(self):
        self.main_layout = QVBoxLayout(self)
        self.main_layout.setContentsMargins(15, 15, 15, 15)
        
        # Outer Glass Background Frame
        self.bg_frame = QFrame(self)
        self.bg_frame.setObjectName("StudentBg")
        self.bg_layout = QVBoxLayout(self.bg_frame)
        self.bg_layout.setContentsMargins(15, 15, 15, 15)
        try:
            from memory.config_manager import load_api_keys
            cfg = load_api_keys()
            is_glass = cfg.get("student_glass_mode", True)
        except Exception:
            is_glass = True
            
        if is_glass:
            bg_style = "background-color: rgba(15, 23, 42, 0.85);"
        else:
            bg_style = "background-color: rgb(15, 23, 42);"
            
        self.bg_frame.setStyleSheet(f"""
            QFrame#StudentBg {{
                {bg_style}
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 12px;
            }}
        """)
        self.main_layout.addWidget(self.bg_frame)
        
        # HEADER BAR
        header_layout = QHBoxLayout()
        header_layout.setContentsMargins(5, 5, 5, 10)
        
        icon_label = QLabel()
        if HAS_QTA:
            icon_label.setPixmap(qta.icon("fa5s.graduation-cap", color=C_PRI).pixmap(30, 30))
        header_layout.addWidget(icon_label)
        
        title_label = QLabel(" MODO ESTUDIANTE & HERRAMIENTAS ACADÉMICAS")
        title_label.setFont(QFont("Segoe UI", 15, QFont.Weight.Bold))
        title_label.setStyleSheet(f"color: {C_PRI}; letter-spacing: 1px;")
        header_layout.addWidget(title_label)
        header_layout.addStretch()
        
        btn_min = QPushButton()
        if HAS_QTA: btn_min.setIcon(qta.icon("fa5s.window-minimize", color="#94a3b8"))
        else: btn_min.setText("-")
        btn_min.setFixedSize(30, 30)
        btn_min.setStyleSheet("QPushButton { border: none; } QPushButton:hover { background-color: rgba(255,255,255,0.1); border-radius: 15px; }")
        btn_min.clicked.connect(self.showMinimized)
        
        btn_close = QPushButton()
        if HAS_QTA: btn_close.setIcon(qta.icon("fa5s.times", color="#94a3b8"))
        else: btn_close.setText("X")
        btn_close.setFixedSize(30, 30)
        btn_close.setStyleSheet("QPushButton { border: none; } QPushButton:hover { background-color: #ef4444; border-radius: 15px; }")
        btn_close.clicked.connect(self.close)
        
        header_layout.addWidget(btn_min)
        header_layout.addWidget(btn_close)
        
        self.bg_layout.addLayout(header_layout)
        
        # TABS WIDGET
        self.tabs = QTabWidget()
        self.bg_layout.addWidget(self.tabs)
        
